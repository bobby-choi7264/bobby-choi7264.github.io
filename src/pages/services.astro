---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { SERVICES, SHOP } from '~/data/shop';
import { worksBy, type CategoryKey } from '~/data/works';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '작업 분야',
  description: '로구로(목선반) 전문, 몰딩·재단, 학생 작품, 공예품 일절 — 성창공예의 작업 분야와 주문 진행 과정.',
};

const details: Record<string, { points: string[]; photos: CategoryKey }> = {
  lathe: {
    points: ['그릇·볼·접시·받침대', '후추·소금 그라인더, 찻잔, 머그', '손잡이·봉·피니얼 등 둥근 부속'],
    photos: 'lathe',
  },
  column: {
    points: ['계단 난간 동자, 장식 기둥', '테이블·의자·가구 다리', '견본 1개로 같은 모양 수량 생산'],
    photos: 'column',
  },
  custom: {
    points: ['졸업 작품·과제 제작 상담', '조명, 오브제, 전시용 구조물', '디자인 도면을 실제 나무로 구현'],
    photos: 'custom',
  },
  furniture: {
    points: ['원목 재단, 프레임, 스툴·테이블', '창살문 등 전통 짜임', '간판·현판 각인'],
    photos: 'furniture',
  },
};

const steps = [
  { icon: 'tabler:message-circle', title: '상담', text: '사진·도면·크기·수량을 알려 주세요. 전화나 문자로 편하게.' },
  { icon: 'tabler:calculator', title: '견적 안내', text: '수종과 가공 방법을 정하고 비용과 기간을 알려 드립니다.' },
  { icon: 'tabler:tools', title: '제작', text: '필요하면 견본을 먼저 깎아 확인한 뒤 본 제작에 들어갑니다.' },
  { icon: 'tabler:package', title: '전달', text: '을지로 매장에서 직접 찾아가시거나 배송을 상의합니다.' },
];
---

<Layout metadata={metadata}>
  <section class="px-4 pt-16 pb-10 md:pt-24 text-center wood-grain">
    <p class="text-sm tracking-[0.3em] text-primary mb-3">WHAT WE MAKE</p>
    <h1 class="font-heading text-4xl md:text-6xl font-bold text-heading">작업 분야</h1>
    <div class="gold-rule mx-auto my-6 max-w-xs"></div>
    <p class="text-muted max-w-2xl mx-auto">나무로 만들 수 있는 것이라면 먼저 물어봐 주세요.</p>
  </section>

  {
    SERVICES.map((service, index) => {
      const photos = worksBy(details[service.key].photos).slice(0, 3);
      return (
        <section id={service.key} class="px-4 py-14 md:py-20 scroll-mt-20">
          <div
            class:list={[
              'max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 items-center',
              { 'lg:[&>*:first-child]:order-2': index % 2 === 1 },
            ]}
          >
            <div>
              <Icon name={service.icon} class="w-10 h-10 text-primary" />
              <h2 class="mt-4 font-heading text-3xl md:text-4xl font-bold text-heading">{service.title}</h2>
              <p class="mt-4 text-lg text-default/90">{service.description}</p>
              <ul class="mt-6 space-y-3">
                {details[service.key].points.map((point) => (
                  <li class="flex gap-3">
                    <Icon name="tabler:check" class="w-5 h-5 mt-1 text-primary shrink-0" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="grid grid-cols-3 gap-3">
              {photos.map((photo, i) => (
                <div class:list={['overflow-hidden rounded-lg border border-primary/20', { 'col-span-3 aspect-[16/10]': i === 0, 'aspect-square': i > 0, 'col-span-1': i > 0 }]}>
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={i === 0 ? [640, 1000] : [320, 480]}
                    sizes={i === 0 ? '(max-width: 1023px) 100vw, 50vw' : '(max-width: 1023px) 33vw, 16vw'}
                    width={i === 0 ? 1000 : 480}
                    height={i === 0 ? 625 : 480}
                    layout="cover"
                    format="webp"
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="px-4 py-20 bg-dark border-t border-primary/15">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">PROCESS</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading">주문은 이렇게 진행됩니다</h2>
      </div>
      <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, index) => (
            <li class="rounded-xl border border-primary/20 p-6">
              <span class="text-primary font-heading text-sm">STEP {index + 1}</span>
              <Icon name={step.icon} class="w-8 h-8 text-primary mt-3" />
              <h3 class="mt-3 font-heading text-xl font-bold text-heading">{step.title}</h3>
              <p class="mt-2 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a href={getPermalink('/contact')} class="btn-primary">주문서 작성</a>
        <a href={SHOP.tel.href} class="btn border-primary/60 text-heading hover:bg-primary/15">{SHOP.tel.label}</a>
      </div>
    </div>
  </section>
</Layout>
