---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { FOREIGN_LOCALES, LANG_META, localize } from '~/i18n';

const title = `페이지를 찾을 수 없습니다`;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-9xl">
          <span class="sr-only">오류</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-3xl font-semibold md:text-3xl">찾으시는 페이지가 없습니다.</p>
        <p class="mt-4 text-lg text-muted">주소가 바뀌었거나 삭제된 페이지입니다. 홈에서 다시 찾아보세요.</p>
        <p class="mt-2 mb-8 text-sm text-muted" lang="en">This page could not be found.</p>
        <div class="flex flex-wrap justify-center gap-2">
          <a href={getHomePermalink()} class="btn-primary">홈으로 가기</a>
          {
            FOREIGN_LOCALES.map((l) => (
              <a
                href={localize(l, '/')}
                lang={LANG_META[l].html}
                class="btn border-primary/40 text-heading hover:bg-primary/15"
              >
                {LANG_META[l].label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
