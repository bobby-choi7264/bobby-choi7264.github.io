---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Intro from '~/components/widgets/Intro.astro';
import HeroShowcase from '~/components/widgets/HeroShowcase.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import PhotoRibbon from '~/components/widgets/PhotoRibbon.astro';
import CraftProcess from '~/components/widgets/CraftProcess.astro';
import Image from '~/components/common/Image.astro';
import { SITE } from 'astrowind:config';
import { SHOP, SERVICES } from '~/data/shop';
import { FEATURED, WORKS, pick } from '~/data/works';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '성창공예 — 55년 장인의 로구로 목기·몰딩 주문제작 | 서울 을지로',
  ignoreTitleTemplate: true,
};

const serviceImages: Record<string, string> = {
  lathe: '~/assets/images/works/lathe-56.jpg',
  column: '~/assets/images/works/column-13.jpg',
  custom: '~/assets/images/works/custom-40.jpg',
  furniture: '~/assets/images/works/furniture-57.jpg',
};

// 검색엔진에 가게 정보를 알려 주는 구조화 데이터 (주소·전화·영업시간)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE?.site}/#business`,
  name: SHOP.name,
  url: SITE?.site,
  telephone: ['+82-2-2292-0062', '+82-10-8548-7264'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '을지로 219',
    addressLocality: '중구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <Intro />
  <HeroShowcase />

  <!-- 작업 분야 -->
  <section id="services" class="px-4 py-20 md:py-28">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">장인의 기술</p>
        <h2 class="font-heading text-3xl md:text-5xl font-bold text-heading">손끝으로 완성하는 네 가지 기술</h2>
        <div class="ruler mx-auto my-6 max-w-md"></div>
        <p class="text-muted max-w-2xl mx-auto">
          도면 한 장, 견본 하나만 있으면 됩니다. 원하는 모양을 정확히, 원하는 수량만큼 깎아 드립니다.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {
          SERVICES.map((service) => (
            <a
              href={getPermalink('/services') + `#${service.key}`}
              class="group relative overflow-hidden rounded-xl border border-primary/20 aspect-[16/10] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
            >
              <Image
                src={serviceImages[service.key]}
                alt=""
                widths={[640, 960]}
                sizes="(max-width: 639px) 100vw, 50vw"
                width={960}
                height={600}
                layout="cover"
                format="webp"
                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent" />
              <div class="absolute bottom-0 p-6 md:p-8">
                <Icon name={service.icon} class="w-8 h-8 text-primary mb-3" />
                <h3 class="font-heading text-2xl font-bold text-heading">{service.title}</h3>
                <p class="mt-2 text-sm md:text-base text-default/85">{service.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 흘러가는 작업 사진 -->
  <section class="py-16 md:py-20">
    <div class="px-4 text-center mb-8">
      <p class="text-sm tracking-[0.3em] text-primary mb-3">손으로 깎은 것들</p>
      <h2 class="font-heading text-2xl md:text-4xl font-bold text-heading">을지로 작업장에서 나온 물건들</h2>
    </div>
    <PhotoRibbon
      rows={[
        [
          'lathe-85',
          'lathe-79',
          'lathe-28',
          'lathe-21',
          'lathe-56',
          'lathe-55',
          'lathe-50',
          'lathe-03',
          'lathe-23',
          'lathe-88',
          'lathe-73',
          'lathe-82',
        ],
        [
          'column-13',
          'custom-40',
          'column-36',
          'furniture-57',
          'column-37',
          'custom-53',
          'column-26',
          'furniture-42',
          'column-17',
          'custom-87',
          'column-29',
          'furniture-22',
        ],
      ]}
    />
  </section>

  <!-- 장인의 작업대 -->
  <section class="relative px-4 py-20 md:py-28 border-y border-primary/15 bg-dark overflow-hidden">
    <span class="hanja-mark -right-8 -top-10 text-[16rem] md:text-[26rem]" aria-hidden="true">匠</span>
    <div class="relative max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 items-center">
      <div class="grid grid-cols-2 gap-3">
        <div
          class="col-span-2 overflow-hidden rounded-lg border border-primary/20 aspect-[16/10] reveal-wipe intersect intersect-once intersect-quarter"
        >
          <Image
            src="~/assets/images/works/column-14.jpg"
            alt="로구로에 걸어 깎고 있는 나무 기둥"
            widths={[480, 800]}
            sizes="(max-width: 1023px) 100vw, 560px"
            width={800}
            height={500}
            layout="cover"
            format="webp"
            class="h-full w-full object-cover"
          />
        </div>
        <div
          class="overflow-hidden rounded-lg border border-primary/20 aspect-square reveal-wipe intersect intersect-once intersect-quarter"
        >
          <Image
            src="~/assets/images/works/workshop-08.jpg"
            alt="작업장의 선반 공구"
            widths={[320, 480]}
            sizes="(max-width: 1023px) 50vw, 280px"
            width={480}
            height={480}
            layout="cover"
            format="webp"
            class="h-full w-full object-cover"
          />
        </div>
        <div
          class="overflow-hidden rounded-lg border border-primary/20 aspect-square reveal-wipe intersect intersect-once intersect-quarter"
        >
          <Image
            src="~/assets/images/works/lathe-27.jpg"
            alt="로구로로 깎은 원목 접시와 볼"
            widths={[320, 480]}
            sizes="(max-width: 1023px) 50vw, 280px"
            width={480}
            height={480}
            layout="cover"
            format="webp"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div>
        <p class="font-heading font-bold leading-none mb-2">
          <span class="gold-text text-7xl md:text-8xl" data-count-to="55">55</span><span
            class="text-3xl md:text-4xl text-primary ml-1">년</span
          >
        </p>
        <p class="text-sm tracking-[0.3em] text-primary mb-8">나무만 깎아 온 장인의 손</p>
        <blockquote class="font-heading text-2xl md:text-4xl font-bold leading-snug text-heading">
          “기계는 나무를 돌릴 뿐,<br /><span class="gold-text">모양을 만드는 건 손입니다.”</span>
        </blockquote>
        <div class="gold-rule my-8 max-w-xs"></div>
        <ol class="space-y-6">
          <li class="flex gap-5">
            <span class="font-heading text-3xl font-bold text-primary/70 leading-none">一</span>
            <div>
              <h3 class="font-heading text-xl font-bold text-heading">목기는 성창공예</h3>
              <p class="mt-1 text-muted">
                그릇·접시·합처럼 손에 닿는 목기를 가장 잘 깎습니다. 나뭇결과 두께를 손으로 읽어 가며 다듬습니다.
              </p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-heading text-3xl font-bold text-primary/70 leading-none">二</span>
            <div>
              <h3 class="font-heading text-xl font-bold text-heading">대량 생산, 방송국 납품까지</h3>
              <p class="mt-1 text-muted">
                견본 하나를 수백 개로 똑같이 옮겨 냅니다. 방송국에 납품할 만큼 수량과 품질을 함께 지킵니다.
              </p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-heading text-3xl font-bold text-primary/70 leading-none">三</span>
            <div>
              <h3 class="font-heading text-xl font-bold text-heading">막막한 주문도 함께</h3>
              <p class="mt-1 text-muted">어떻게 만들어야 할지 모르겠다면, 깎는 방법부터 같이 찾습니다.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <CraftProcess />

  <!-- 대표 작업 -->
  <Gallery id="works" columns={4} images={pick(FEATURED)}>
    <Fragment slot="tagline">손으로 깎은 것들</Fragment>
    <Fragment slot="title">대표 작업</Fragment>
    <Fragment slot="subtitle">사진을 누르면 크게 볼 수 있습니다.</Fragment>
  </Gallery>
  <div class="text-center -mt-6 mb-20">
    <a href={getPermalink('/works')} class="btn border-primary/60 text-heading hover:bg-primary/15">
      작업물 전체 보기 ({WORKS.length}점) <Icon name="tabler:arrow-right" class="w-5 h-5 ml-2" />
    </a>
  </div>

  <!-- 주문 안내 -->
  <section class="relative px-4 py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/column-04.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={900}
        layout="cover"
        format="webp"
        class="h-full w-full object-cover parallax-img"
      />
      <div class="absolute inset-0 bg-black/75"></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-sm tracking-[0.3em] text-primary mb-3">주문</p>
      <h2 class="font-heading text-3xl md:text-5xl font-bold text-heading">만들고 싶은 것이 있으신가요?</h2>
      <p class="mt-6 text-lg text-default/90">
        사진이나 도면, 대략적인 크기만 알려 주시면 제작 방법과 견적을 안내해 드립니다.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={getPermalink('/contact')} class="btn-primary"
          ><Icon name="tabler:clipboard-text" class="w-5 h-5 mr-2" />주문서 작성</a
        >
        <a href={SHOP.tel.href} class="btn border-primary/60 text-heading hover:bg-primary/15"
          ><Icon name="tabler:phone" class="w-5 h-5 mr-2" />{SHOP.tel.label}</a
        >
        <a href={SHOP.mobile.sms} class="btn border-white/30 text-heading hover:bg-white/10"
          ><Icon name="tabler:message" class="w-5 h-5 mr-2" />문자로 사진 보내기</a
        >
      </div>
    </div>
  </section>

  <BlogLatestPosts count={3} linkText="소식 전체 보기">
    <Fragment slot="title">성창공예 소식</Fragment>
  </BlogLatestPosts>

  <!-- 을지로 작업장 -->
  <section class="relative overflow-hidden py-28 md:py-40 px-4">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/workshop-47.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={900}
        layout="cover"
        format="webp"
        class="h-full w-full object-cover parallax-img sepia-[0.3]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/30"></div>
    </div>
    <div class="relative max-w-6xl mx-auto">
      <p class="text-sm tracking-[0.3em] text-primary mb-4">서울 중구 을지로 219</p>
      <p class="font-heading text-3xl md:text-6xl font-bold leading-tight text-heading">
        오늘도 을지로에서<br /><span class="gold-text">로구로가 돌아갑니다</span>
      </p>
      <div class="ruler my-8 max-w-sm" style="-webkit-mask-image:none;mask-image:none"></div>
      <a href={getPermalink('/about')} class="btn border-primary/60 text-heading hover:bg-primary/15">
        공방 이야기 보기 <Icon name="tabler:arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </section>

  <VisitInfo />
</Layout>

<script>
  // 숫자가 0부터 올라가며 채워지는 효과 (예: 55년)
  const run = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-count-to]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const to = Number(el.dataset.countTo);
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1600);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }),
      { threshold: 0.6 }
    );
    // 화면 가까이 오면 0으로 바꿔 두고, 충분히 보이면 올라가기 시작
    const near = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          near.unobserve(entry.target);
          if (entry.intersectionRatio < 0.6) (entry.target as HTMLElement).textContent = '0';
          io.observe(entry.target);
        }),
      { rootMargin: '0px 0px 300px 0px' }
    );
    els.forEach((el) => near.observe(el));
  };
  document.addEventListener('astro:page-load', run);
</script>
