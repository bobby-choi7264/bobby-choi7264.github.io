---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { SHOP } from '~/data/shop';

const metadata = {
  title: '소개',
  description: '55년 경력 장인이 서울 을지로에서 목선반(로구로)으로 목기를 깎는 공방, 성창공예를 소개합니다.',
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden px-4 pt-20 pb-14 md:pt-32 md:pb-20 text-center">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/column-14.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={700}
        layout="cover"
        format="webp"
        loading="eager"
        class="h-full w-full object-cover parallax-img sepia-[0.4]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-[#140f0b]"></div>
    </div>
    <div class="relative">
      <p class="text-sm tracking-[0.3em] text-primary mb-3">공방 소개</p>
      <h1 class="font-heading text-4xl md:text-6xl font-bold text-heading">{SHOP.name}</h1>
      <div class="ruler mx-auto my-6 max-w-md"></div>
      <p class="text-default/80">55년, 을지로에서 나무를 돌려 깎는 공방</p>
    </div>
  </section>

  <section class="px-4 py-14 md:py-20">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 items-center">
      <div class="overflow-hidden rounded-xl border border-primary/25 aspect-[3/4] max-w-md mx-auto w-full">
        <Image
          src="~/assets/images/works/workshop-46.jpg"
          alt="을지로 성창공예 매장 전경"
          widths={[480, 800]}
          sizes="(max-width: 1023px) 100vw, 448px"
          width={800}
          height={1066}
          layout="cover"
          format="webp"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="space-y-6 text-lg leading-relaxed">
        <p class="font-heading font-bold leading-none">
          <span class="gold-text text-6xl md:text-7xl">55</span><span class="text-2xl text-primary ml-1">년</span>
          <span class="ml-3 align-middle text-sm tracking-[0.3em] text-primary">나무만 깎아 온 손</span>
        </p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading">
          나무 한 토막이<br /><span class="gold-text">쓰임이 되기까지</span>
        </h2>
        <p>
          성창공예는 <b class="text-heading">55년 동안 나무를 깎아 온 장인</b>의 공방입니다. 서울 을지로에서 목선반, 일본말로 <b class="text-heading">로구로</b>라고 부르는 기계로 나무를 돌려
          깎습니다. 빠르게 돌아가는 나무에 날을 대어 기둥과 다리, 그릇과 받침처럼 둥근 형태를 만들어 냅니다. 그중에서도
          그릇·접시·합 같은 <b class="text-heading">목기</b>는 성창공예가 가장 자신 있는 분야입니다.
        </p>
        <p>
          계단 난간과 가구 다리 같은 <b class="text-heading">몰딩 부재의 대량 생산</b>과 <b class="text-heading">방송국 납품</b>부터, 디자인을 공부하는 학생들의
          <b class="text-heading">졸업 작품</b>, 가게 간판과 생활 소품까지 — 나무로 만들 수 있는 것이라면 무엇이든
          상담합니다.
        </p>
        <p>
          견본 하나를 수백 개로 똑같이 옮겨 내는 정밀함, 그리고 처음 보는 모양도 방법을 찾아내는 55년의 경험. 그것이
          성창공예가 가진 기술입니다.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 pb-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">작업장 풍경</p>
        <h2 class="font-heading text-2xl md:text-4xl font-bold text-heading">톱밥 냄새 나는 을지로 공방</h2>
        <div class="ruler mx-auto my-6 max-w-md"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[140px] md:auto-rows-[190px] gap-3">
        {
          [
            { file: 'workshop-47', cls: 'col-span-2 row-span-2' },
            { file: 'column-16', cls: '' },
            { file: 'workshop-08', cls: '' },
            { file: 'lathe-27', cls: 'row-span-2' },
            { file: 'column-29', cls: '' },
            { file: 'furniture-07', cls: 'col-span-2 md:col-span-1' },
            { file: 'column-49', cls: 'col-span-2' },
            { file: 'lathe-55', cls: 'col-span-2 md:col-span-1' },
          ].map(({ file, cls }) => (
            <div class={`overflow-hidden rounded-lg border border-primary/20 reveal-wipe intersect intersect-once intersect-quarter ${cls}`}>
              <Image
                src={`~/assets/images/works/${file}.jpg`}
                alt=""
                widths={[400, 800]}
                sizes="(max-width: 767px) 50vw, 25vw"
                width={800}
                height={600}
                layout="cover"
                format="webp"
                class="h-full w-full object-cover transition duration-700 hover:scale-105 sepia-[0.2] hover:sepia-0"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <VisitInfo />
</Layout>
