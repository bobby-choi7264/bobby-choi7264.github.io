---
import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import { CATEGORIES, WORKS, worksBy } from '~/data/works';

const metadata = {
  title: '작업물',
  description: `성창공예가 직접 깎아 만든 로구로 공예품, 기둥·난간, 가구, 주문 제작 작업물 ${WORKS.length}점.`,
};
---

<Layout metadata={metadata}>
  <section class="px-4 pt-16 pb-6 md:pt-24 text-center wood-grain">
    <p class="text-sm tracking-[0.3em] text-primary mb-3">작업물</p>
    <h1 class="font-heading text-4xl md:text-6xl font-bold text-heading">작업물</h1>
    <div class="ruler mx-auto my-6 max-w-md"></div>
    <p class="text-muted">직접 깎아 만든 작업 {WORKS.length}점 · 사진을 누르면 크게 볼 수 있습니다.</p>

    <nav class="mt-10 flex flex-wrap justify-center gap-2" aria-label="작업 분류">
      {
        CATEGORIES.map((category) => (
          <a
            href={`#${category.key}`}
            class="rounded-full border border-primary/40 px-4 py-2 text-sm text-heading hover:bg-primary hover:text-[#140f0b] transition"
          >
            {category.title} <span class="text-primary/80">{worksBy(category.key).length}</span>
          </a>
        ))
      }
    </nav>
  </section>

  {
    CATEGORIES.map((category) => (
      <Gallery id={category.key} columns={4} images={worksBy(category.key)}>
        <Fragment slot="title">{category.title}</Fragment>
        <Fragment slot="subtitle">{category.description}</Fragment>
      </Gallery>
    ))
  }
</Layout>
