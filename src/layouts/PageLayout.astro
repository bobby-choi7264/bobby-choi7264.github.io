---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getHeaderData, getFooterData } from '~/navigation';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { langFromPath, localize, useT, type Lang } from '~/i18n';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: Lang;
  /** 지금 페이지 이름. 주면 상단 메뉴 아래에 '홈 > 페이지 이름'을 보여 줍니다 (소식 페이지와 같은 모양) */
  crumb?: string;
}

const { metadata, lang = langFromPath(Astro.url.pathname), crumb } = Astro.props;
---

<Layout metadata={metadata} lang={lang}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {Astro.slots.has('announcement') && <slot name="announcement" />}
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...getHeaderData(lang)} lang={lang} isSticky />}
  <main id="main" class="flex-1" tabindex="-1">
    {
      crumb && (
        <Breadcrumbs
          bar
          items={[{ text: useT(lang).nav.home, href: localize(lang, '/'), icon: 'tabler:home' }, { text: crumb }]}
        />
      )
    }
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...getFooterData(lang)} />}
</Layout>
