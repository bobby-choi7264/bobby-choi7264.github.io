---
// Fonts are loaded from Google Fonts in Layout.astro: Noto Sans KR for body
// text and headings (도장만 Noto Serif KR). Colors: warm walnut background with brass accents.
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: 'Noto Sans KR', sans-serif;
    --aw-font-serif: 'Noto Serif KR', serif;
    --aw-font-heading: 'Noto Sans KR', sans-serif;

    --aw-color-primary: rgb(196 150 84);
    --aw-color-secondary: rgb(168 122 62);
    --aw-color-accent: rgb(224 186 120);

    --aw-color-text-heading: rgb(250 244 234);
    --aw-color-text-default: rgb(238 229 215);
    --aw-color-text-muted: rgb(238 229 215 / 78%);
    --aw-color-bg-page: rgb(36 27 20);

    --aw-color-bg-page-dark: rgb(28 21 15);

    ::selection {
      background-color: rgb(196 150 84);
      color: rgb(20 15 11);
    }
  }

  body {
    word-break: keep-all;
  }
</style>
