---
// Fonts are loaded from Google Fonts in Layout.astro: Noto Sans KR for body
// text, Noto Serif KR for headings. Colors: dark walnut background with brass accents.
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: 'Noto Sans KR', sans-serif;
    --aw-font-serif: 'Noto Serif KR', serif;
    --aw-font-heading: 'Noto Serif KR', serif;

    --aw-color-primary: rgb(196 150 84);
    --aw-color-secondary: rgb(168 122 62);
    --aw-color-accent: rgb(224 186 120);

    --aw-color-text-heading: rgb(245 236 222);
    --aw-color-text-default: rgb(226 214 196);
    --aw-color-text-muted: rgb(226 214 196 / 66%);
    --aw-color-bg-page: rgb(20 15 11);

    --aw-color-bg-page-dark: rgb(14 10 7);

    ::selection {
      background-color: rgb(196 150 84);
      color: rgb(20 15 11);
    }
  }

  body {
    word-break: keep-all;
  }
</style>
