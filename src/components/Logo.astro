---
import BrandCrown from '~/components/common/BrandCrown.astro';
import Mark from '~/components/common/Mark.astro';
import { SHOP } from '~/data/shop';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 flex items-center gap-2.5 whitespace-nowrap">
  <Mark class="h-9 w-9 md:h-8 md:w-8 text-primary shrink-0" />
  <span class="inline-flex flex-col gap-1">
    <BrandCrown class="text-sm md:text-[13px] text-[#f3d9a4]" />
    <span class="font-heading text-xl md:text-lg leading-none font-bold gold-text tracking-[0.04em]">{SHOP.name}</span>
  </span>
  <span class="hidden sm:inline lg:hidden xl:inline self-end pb-px text-[11px] tracking-[0.08em] text-primary/80"
    >{SHOP.nameEn}</span
  >
</span>
