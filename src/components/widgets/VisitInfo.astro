---
// 전화·문자·길찾기 버튼과 지도. 홈과 주문·문의 페이지에서 함께 씁니다.
import { Icon } from 'astro-icon/components';
import { SHOP, MAP_LINKS } from '~/data/shop';

export interface Props {
  id?: string;
  showMap?: boolean;
}

const { id = 'visit', showMap = true } = Astro.props;
---

<section id={id} class="relative px-4 py-16 md:py-24 wood-grain">
  <div class="max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 items-start">
    <div>
      <p class="text-sm tracking-[0.3em] text-primary mb-3">찾아오시는 길</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading">오시는 길 · 연락처</h2>
      <div class="gold-rule my-6 max-w-xs"></div>

      <dl class="space-y-5 text-lg">
        <div class="flex gap-4">
          <dt><Icon name="tabler:map-pin" class="w-6 h-6 text-primary" /><span class="sr-only">주소</span></dt>
          <dd class="text-heading">{SHOP.address}</dd>
        </div>
        <div class="flex gap-4">
          <dt><Icon name="tabler:clock" class="w-6 h-6 text-primary" /><span class="sr-only">영업시간</span></dt>
          <dd>
            <span class="text-heading">{SHOP.hours}</span>
            <span class="block text-sm text-muted">{SHOP.closed}</span>
          </dd>
        </div>
        <div class="flex gap-4">
          <dt><Icon name="tabler:phone" class="w-6 h-6 text-primary" /><span class="sr-only">전화</span></dt>
          <dd class="text-heading">
            <a class="hover:text-primary" href={SHOP.tel.href}>{SHOP.tel.label}</a>
            <span class="text-muted mx-2">/</span>
            <a class="hover:text-primary" href={SHOP.mobile.href}>{SHOP.mobile.label}</a>
          </dd>
        </div>
      </dl>

      <div class="mt-8 grid grid-cols-2 gap-3 max-w-md">
        <a href={SHOP.tel.href} class="btn-primary"><Icon name="tabler:phone-call" class="w-5 h-5 mr-2" />가게 전화</a>
        <a href={SHOP.mobile.href} class="btn border-primary/60 text-heading hover:bg-primary/15"
          ><Icon name="tabler:device-mobile" class="w-5 h-5 mr-2" />휴대폰 전화</a
        >
        <a href={MAP_LINKS.naver} target="_blank" rel="noopener" class="btn border-white/25 text-heading hover:bg-white/10"
          ><Icon name="tabler:map-2" class="w-5 h-5 mr-2" />네이버 지도</a
        >
        <a href={MAP_LINKS.kakao} target="_blank" rel="noopener" class="btn border-white/25 text-heading hover:bg-white/10"
          ><Icon name="tabler:map-2" class="w-5 h-5 mr-2" />카카오맵</a
        >
      </div>
      <p class="mt-3 text-sm text-muted">
        <a href={MAP_LINKS.google} target="_blank" rel="noopener" class="underline hover:text-primary">구글 지도로 보기</a>
      </p>
    </div>

    {
      showMap && (
        <div class="overflow-hidden rounded-xl border border-primary/30 shadow-2xl shadow-black/40 aspect-[4/3]">
          <iframe
            title={`${SHOP.name} 위치 지도`}
            src={MAP_LINKS.embed}
            class="h-full w-full grayscale-[35%] sepia-[25%]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      )
    }
  </div>
</section>
