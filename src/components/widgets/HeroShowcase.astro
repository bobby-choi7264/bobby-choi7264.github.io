---
// 화면 전체를 채우는 작업 사진 슬라이드쇼 + 가게 소개 문구.
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Seal from '~/components/common/Seal.astro';
import WorkshopLight from '~/components/widgets/WorkshopLight.astro';
import OpenStatus from '~/components/common/OpenStatus.astro';
import { HERO_SLIDES, pick } from '~/data/works';
import { shopFor } from '~/data/shop';
import { langFromPath, localize, useT } from '~/i18n';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang).hero;
const shop = shopFor(lang);
const slides = pick(HERO_SLIDES, lang);
const seconds = 36 / slides.length;
// 첫 사진이 처음부터 다 보이게 시작(36초의 3% = 서서히 나타나는 시간만큼 앞당김). 입장 화면에서 끊김 없이 이어지도록
const delay = (index: number) => `${(index * seconds - 36 * 0.03).toFixed(2)}s`;
---

<section
  class="relative -mt-[115px] lg:-mt-[72px] flex min-h-[100svh] flex-col w-full overflow-hidden bg-[#0e0a07]"
  data-spotlight
>
  <div class="absolute inset-0" aria-hidden="true">
    {
      slides.map((slide, index) => (
        <div class="hero-slide" style={`animation-delay:${delay(index)}`}>
          <Image
            src={slide.src}
            alt=""
            widths={[768, 1280, 1800]}
            sizes="100vw"
            width={1800}
            height={1000}
            layout="none"
            format="webp"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            style={`animation-delay:${delay(index)}`}
          />
        </div>
      ))
    }
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/45 to-[#140f0b]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(0,0,0,0.55)_100%)]"></div>
    <WorkshopLight />
    <div class="hero-spot" aria-hidden="true"></div>
  </div>

  <div
    class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pt-[136px] pb-20 lg:pt-[96px] text-center"
  >
    <div class="hero-reveal flex flex-col items-center">
      <p
        class:list={[
          'mb-5 text-xs md:text-sm text-primary text-balance',
          lang === 'en' ? 'tracking-[0.2em] uppercase' : 'tracking-[0.45em] pl-[0.45em]',
        ]}
      >
        {t.kicker}{
          lang !== 'en' && (
            <span class="hidden sm:inline" translate="no">
              {' '}
              · {shop.nameEn}
            </span>
          )
        }
      </p>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-7xl font-bold leading-tight text-heading">
        <span class="hero-line">{t.title1}</span><br /><span class="hero-line gold-text">{t.title2}</span><Seal
          class="ml-3 align-top text-sm sm:text-base md:text-xl"
        />
      </h1>
      <p class="mt-6 max-w-xl text-base md:text-lg text-default/90">
        {t.lead}
        <br class="hidden sm:inline" />
        <span class="mt-2 block text-primary/90 text-balance">{t.tags}</span>
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={localize(lang, '/contact')} class="btn-primary"
          ><Icon name="tabler:clipboard-text" class="w-5 h-5 mr-2" />{t.order}</a
        >
        <a href={shop.tel.href} class="btn border-primary/60 text-heading hover:bg-primary/15"
          ><Icon name="tabler:phone" class="w-5 h-5 mr-2" />{t.call}</a
        >
        <a href={localize(lang, '/works')} class="btn border-white/30 text-heading hover:bg-white/10"
          ><Icon name="tabler:photo" class="w-5 h-5 mr-2" />{t.works}</a
        >
      </div>
      <div class="mt-6 min-h-8">
        <OpenStatus />
      </div>
    </div>
  </div>

  <a
    href="#services"
    class="absolute bottom-6 left-1/2 z-10 inline-flex h-12 w-12 -translate-x-1/2 items-center justify-center text-primary/80 hover:text-primary motion-safe:animate-bounce"
    aria-label={t.scroll}
  >
    <Icon name="tabler:chevrons-down" class="w-8 h-8" />
  </a>
</section>

<script>
  // 작업등: 마우스를 움직이면 따뜻한 빛이 그쪽을 비춤 (마우스가 있는 컴퓨터에서만)
  const setup = () => {
    const hero = document.querySelector<HTMLElement>('[data-spotlight]:not([data-spot-ready])');
    if (!hero || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    hero.dataset.spotReady = '';
    let frame = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        hero.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        hero.classList.add('spot-on');
      });
    });
    hero.addEventListener('pointerleave', () => hero.classList.remove('spot-on'));
  };
  document.addEventListener('astro:page-load', setup);
</script>
