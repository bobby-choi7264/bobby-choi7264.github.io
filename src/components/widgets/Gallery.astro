---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Gallery as Props } from '~/types';
import { getImage } from 'astro:assets';
import { findImage } from '~/utils/images';
import { langFromPath, useT } from '~/i18n';

const g = useT(langFromPath(Astro.url.pathname)).gallery;

// Image grid with an optional lightbox built on the native <dialog>: no
// library, keyboard friendly (Escape closes, arrows navigate), works without
// JavaScript (the images are simply not clickable).

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  images = [],
  columns = 3,
  lightbox = true,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// 크게 보기 창에 쓸, 잘리지 않은 큰 사진 (목록의 사진은 4:3으로 잘려 있음)
const fullOf = async (src: unknown) => {
  const image = await findImage(src as string);
  if (!image || typeof image === 'string') return undefined;
  const result = await getImage({ src: image, width: Math.min(1600, image.width), format: 'webp' });
  return result.src;
};
// 비슷한 사진 묶음(photos)이 있으면 묶음 사진 전부, 없으면 그 사진 한 장
const viewerPhotos = await Promise.all(
  images.map(async (item) => {
    const photos = (item as { photos?: { src: unknown; alt: string }[] }).photos ?? [{ src: item.src, alt: item.alt }];
    return Promise.all(photos.map(async (photo) => ({ src: await fullOf(photo.src), alt: photo.alt })));
  })
);

const columnsClass =
  columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <aw-gallery>
    <ul
      class:list={[
        'grid gap-x-3 gap-y-6 md:gap-6 list-none',
        images.length > 1 ? 'grid-cols-2' : 'grid-cols-1',
        columnsClass,
      ]}
    >
      {
        images.map(({ src, alt, caption, href }, index) => (
          <li
            class:list={[
              { 'is-stack': viewerPhotos[index].length > 1 },
              'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            ]}
          >
            <figure>
              <button
                type="button"
                class="group relative block w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800 ring-1 ring-primary/15 hover:ring-primary/60 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                data-aw-gallery-open={lightbox ? index : undefined}
                data-aw-gallery-photos={JSON.stringify(viewerPhotos[index])}
                disabled={!lightbox}
                aria-label={
                  lightbox
                    ? `${g.open}: ${alt || caption || index + 1}${viewerPhotos[index].length > 1 ? ` (${g.photos(viewerPhotos[index].length)})` : ''}`
                    : undefined
                }
              >
                <Image
                  class="aspect-[4/3] w-full object-cover transition duration-700 sepia-[0.15] group-hover:sepia-0 group-hover:scale-[1.06]"
                  widths={[400, 640]}
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
                  width={400}
                  height={300}
                  layout="cover"
                  format="webp"
                  src={src}
                  alt={alt || ''}
                />
                {viewerPhotos[index].length > 1 && (
                  <span class="stack-badge" aria-hidden="true">
                    <Icon name="tabler:photo" class="h-3.5 w-3.5" />
                    {viewerPhotos[index].length}
                  </span>
                )}
              </button>
              {caption && (
                <figcaption class="mt-2 text-sm text-muted">
                  {href ? (
                    <a href={href} class="inline-flex items-center gap-1 hover:text-primary hover:underline">
                      {caption}
                      <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  ) : (
                    caption
                  )}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>

    {
      lightbox && (
        <dialog
          class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm open:flex open:flex-col"
          aria-label={g.dialog}
        >
          <form method="dialog" class="absolute right-3 top-3 z-10">
            <button
              type="submit"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
              aria-label={g.close}
            >
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </form>
          <button
            type="button"
            class="absolute left-2 sm:left-4 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-prev
            aria-label={g.prev}
          >
            <Icon name="tabler:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="absolute right-2 sm:right-4 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-next
            aria-label={g.next}
          >
            <Icon name="tabler:chevron-right" class="h-5 w-5" />
          </button>
          {/* 창은 화면 크기로 고정하고 사진만 그 안에 맞춰 넣음 → 가로·세로 사진이 바뀌어도 화살표·닫기 위치가 그대로 */}
          <div
            data-aw-gallery-stage
            class="flex min-h-0 flex-1 items-center justify-center overflow-hidden px-3 pt-16 pb-2 sm:px-20 touch-pan-y touch-pinch-zoom select-none"
          >
            <img data-aw-gallery-img class="h-full w-full object-contain" alt="" draggable="false" />
          </div>
          <div class="flex h-16 shrink-0 flex-col items-center justify-start gap-2 px-4">
            <p data-aw-gallery-caption class="text-center text-sm text-white/90" aria-live="polite" />
            <div data-aw-gallery-thumbs class="flex justify-center gap-1.5" aria-hidden="true" />
          </div>
        </dialog>
      )
    }
  </aw-gallery>
</WidgetWrapper>

<script>
  class AwGallery extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-aw-gallery-open]')];
      const img = dialog.querySelector<HTMLImageElement>('[data-aw-gallery-img]')!;
      const caption = dialog.querySelector<HTMLElement>('[data-aw-gallery-caption]')!;
      const thumbs = dialog.querySelector<HTMLElement>('[data-aw-gallery-thumbs]')!;
      // 모든 사진을 한 줄로: 묶음은 그 안의 사진들이 이어서 나옴
      type Photo = { src?: string; alt: string };
      const flat = buttons.flatMap((button, item) => {
        const photos: Photo[] = JSON.parse(button.dataset.awGalleryPhotos || '[]');
        const label = button.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
        return photos.map((photo, n) => ({ ...photo, item, n, total: photos.length, label }));
      });
      let current = 0;
      const show = (index: number) => {
        current = (index + flat.length) % flat.length;
        const photo = flat[current];
        const next = photo.src || buttons[photo.item].querySelector('img')?.currentSrc || '';
        // 새 사진을 다 받을 때까지 이전 사진을 감춰서, 앞 사진이 잠깐 비치지 않게 함
        if (img.getAttribute('src') !== next) {
          img.classList.add('is-loading');
          img.removeAttribute('src');
          img.src = next;
        }
        img.alt = photo.alt;
        caption.textContent = photo.total > 1 ? `${photo.label} · ${photo.n + 1} / ${photo.total}` : photo.label;
        // 묶음이면 아래에 점으로 몇 번째 사진인지 표시
        thumbs.replaceChildren(
          ...(photo.total > 1
            ? Array.from({ length: photo.total }, (_, n) => {
                const dot = document.createElement('span');
                dot.className = 'viewer-dot' + (n === photo.n ? ' is-current' : '');
                return dot;
              })
            : [])
        );
      };
      buttons.forEach((button, index) =>
        button.addEventListener('click', () => {
          show(flat.findIndex((p) => p.item === index));
          dialog.showModal();
        })
      );
      const prevButton = dialog.querySelector<HTMLButtonElement>('[data-aw-gallery-prev]')!;
      const nextButton = dialog.querySelector<HTMLButtonElement>('[data-aw-gallery-next]')!;
      prevButton.addEventListener('click', () => show(current - 1));
      nextButton.addEventListener('click', () => show(current + 1));

      // 끌어서 넘기기 (손가락·마우스): 사진이 따라 움직이고, 충분히 끌거나 빠르게 튕기면 옆 사진으로
      const stage = dialog.querySelector<HTMLElement>('[data-aw-gallery-stage]')!;
      let drag: { id: number; x: number; y: number; t: number; dx: number; on: boolean } | undefined;
      let justDragged = false;
      const moveImg = (dx: number, ms = 0) => {
        img.style.transition = ms ? `transform ${ms}ms ease, opacity 0.25s ease` : 'none';
        img.style.transform = dx ? `translateX(${dx}px)` : '';
      };
      stage.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0 || flat.length < 2) return;
        drag = { id: event.pointerId, x: event.clientX, y: event.clientY, t: performance.now(), dx: 0, on: false };
      });
      stage.addEventListener('pointermove', (event) => {
        if (!drag || event.pointerId !== drag.id) return;
        const dx = event.clientX - drag.x;
        const dy = event.clientY - drag.y;
        if (!drag.on) {
          if (Math.abs(dx) < 8) return;
          // 위아래로 더 많이 움직였으면 넘기기가 아님
          if (Math.abs(dy) > Math.abs(dx)) return void (drag = undefined);
          drag.on = true;
          stage.setPointerCapture(event.pointerId);
        }
        drag.dx = dx;
        moveImg(dx);
      });
      const endDrag = (event: PointerEvent) => {
        if (!drag || event.pointerId !== drag.id) return;
        const { dx, on, t } = drag;
        drag = undefined;
        if (!on) return;
        justDragged = true;
        setTimeout(() => (justDragged = false));
        const fast = Math.abs(dx) / (performance.now() - t) > 0.5;
        if (
          event.type === 'pointercancel' ||
          (Math.abs(dx) < stage.clientWidth * 0.18 && !(fast && Math.abs(dx) > 30))
        ) {
          moveImg(0, 200);
          return;
        }
        const dir = dx < 0 ? 1 : -1;
        moveImg(-dir * stage.clientWidth, 180);
        setTimeout(() => {
          // 단추를 누른 것처럼 처리 (효과음도 같이)
          (dir > 0 ? nextButton : prevButton).click();
          moveImg(dir * 60);
          img.getBoundingClientRect();
          moveImg(0, 250);
        }, 180);
      };
      // 움직임이 끝나면 원래 스타일(tailwind.css의 불러오는 동안 감춤)로 되돌림
      img.addEventListener('transitionend', () => {
        if (!drag) img.style.transition = '';
      });
      stage.addEventListener('pointerup', endDrag);
      stage.addEventListener('pointercancel', endDrag);
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      const loaded = () => img.classList.remove('is-loading');
      img.addEventListener('load', loaded);
      img.addEventListener('error', loaded);
      // 창을 닫으면 사진을 비워 둠 (다음에 열 때 이전 사진이 보이지 않게)
      dialog.addEventListener('close', () => {
        // 닫자마자 다른 사진을 열었으면(이미 다시 열려 있으면) 건드리지 않음
        if (dialog.open) return;
        moveImg(0);
        img.removeAttribute('src');
        img.classList.add('is-loading');
      });
      // Click on the backdrop closes the viewer.
      dialog.addEventListener('click', (event) => {
        // 사진 바깥의 빈 곳을 누르면 닫기
        const target = event.target as HTMLElement;
        if (justDragged) return;
        if (target === dialog || target.hasAttribute('data-aw-gallery-stage')) dialog.close();
      });
    }
  }
  if (!customElements.get('aw-gallery')) customElements.define('aw-gallery', AwGallery);
</script>
