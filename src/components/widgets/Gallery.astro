---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Gallery as Props } from '~/types';
import { getImage } from 'astro:assets';
import { findImage } from '~/utils/images';
import { langFromPath, useT } from '~/i18n';

const g = useT(langFromPath(Astro.url.pathname)).gallery;

// Image grid with an optional lightbox built on the native <dialog>: no
// library, keyboard friendly (Escape closes, arrows navigate), works without
// JavaScript (the images are simply not clickable).

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  images = [],
  columns = 3,
  lightbox = true,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// 크게 보기 창에 쓸, 잘리지 않은 큰 사진 (목록의 사진은 4:3으로 잘려 있음)
const fullOf = async (src: unknown) => {
  const image = await findImage(src as string);
  if (!image || typeof image === 'string') return undefined;
  const result = await getImage({ src: image, width: Math.min(1600, image.width), format: 'webp' });
  return result.src;
};
// 비슷한 사진 묶음(photos)이 있으면 묶음 사진 전부, 없으면 그 사진 한 장
const viewerPhotos = await Promise.all(
  images.map(async (item) => {
    const photos = (item as { photos?: { src: unknown; alt: string }[] }).photos ?? [{ src: item.src, alt: item.alt }];
    return Promise.all(photos.map(async (photo) => ({ src: await fullOf(photo.src), alt: photo.alt })));
  })
);

const columnsClass =
  columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <aw-gallery>
    <ul
      class:list={[
        'grid gap-x-3 gap-y-6 md:gap-6 list-none',
        images.length > 1 ? 'grid-cols-2' : 'grid-cols-1',
        columnsClass,
      ]}
    >
      {
        images.map(({ src, alt, caption, href }, index) => (
          <li
            class:list={[
              { 'is-stack': viewerPhotos[index].length > 1 },
              'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            ]}
          >
            <figure>
              <button
                type="button"
                class="group relative block w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800 ring-1 ring-primary/15 hover:ring-primary/60 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                data-aw-gallery-open={lightbox ? index : undefined}
                data-aw-gallery-photos={JSON.stringify(viewerPhotos[index])}
                disabled={!lightbox}
                aria-label={
                  lightbox
                    ? `${g.open}: ${alt || caption || index + 1}${viewerPhotos[index].length > 1 ? ` (${g.photos(viewerPhotos[index].length)})` : ''}`
                    : undefined
                }
              >
                <Image
                  class="aspect-[4/3] w-full object-cover transition duration-700 sepia-[0.15] group-hover:sepia-0 group-hover:scale-[1.06]"
                  widths={[400, 640]}
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
                  width={400}
                  height={300}
                  layout="cover"
                  format="webp"
                  src={src}
                  alt={alt || ''}
                />
                {viewerPhotos[index].length > 1 && (
                  <span class="stack-badge" aria-hidden="true">
                    <Icon name="tabler:photo" class="h-3.5 w-3.5" />
                    {viewerPhotos[index].length}
                  </span>
                )}
              </button>
              {caption && (
                <figcaption class="mt-2 text-sm text-muted">
                  {href ? (
                    <a href={href} class="inline-flex items-center gap-1 hover:text-primary hover:underline">
                      {caption}
                      <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  ) : (
                    caption
                  )}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>

    {
      lightbox && (
        <dialog
          class="m-auto max-h-[92vh] max-w-[92vw] rounded-lg bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm open:flex open:flex-col"
          aria-label={g.dialog}
        >
          <form method="dialog" class="absolute right-2 top-2 z-10">
            <button
              type="submit"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
              aria-label={g.close}
            >
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </form>
          <button
            type="button"
            class="absolute left-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-prev
            aria-label={g.prev}
          >
            <Icon name="tabler:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="absolute right-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-next
            aria-label={g.next}
          >
            <Icon name="tabler:chevron-right" class="h-5 w-5" />
          </button>
          <img data-aw-gallery-img class="max-h-[78vh] w-auto rounded-lg object-contain" alt="" />
          <p data-aw-gallery-caption class="mt-2 text-center text-sm text-white/90" aria-live="polite" />
          <div data-aw-gallery-thumbs class="mt-2 flex justify-center gap-1.5" aria-hidden="true" />
        </dialog>
      )
    }
  </aw-gallery>
</WidgetWrapper>

<script>
  class AwGallery extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-aw-gallery-open]')];
      const img = dialog.querySelector<HTMLImageElement>('[data-aw-gallery-img]')!;
      const caption = dialog.querySelector<HTMLElement>('[data-aw-gallery-caption]')!;
      const thumbs = dialog.querySelector<HTMLElement>('[data-aw-gallery-thumbs]')!;
      // 모든 사진을 한 줄로: 묶음은 그 안의 사진들이 이어서 나옴
      type Photo = { src?: string; alt: string };
      const flat = buttons.flatMap((button, item) => {
        const photos: Photo[] = JSON.parse(button.dataset.awGalleryPhotos || '[]');
        const label = button.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
        return photos.map((photo, n) => ({ ...photo, item, n, total: photos.length, label }));
      });
      let current = 0;
      const show = (index: number) => {
        current = (index + flat.length) % flat.length;
        const photo = flat[current];
        const next = photo.src || buttons[photo.item].querySelector('img')?.currentSrc || '';
        // 새 사진을 다 받을 때까지 이전 사진을 감춰서, 앞 사진이 잠깐 비치지 않게 함
        if (img.getAttribute('src') !== next) {
          img.classList.add('is-loading');
          img.removeAttribute('src');
          img.src = next;
        }
        img.alt = photo.alt;
        caption.textContent = photo.total > 1 ? `${photo.label} · ${photo.n + 1} / ${photo.total}` : photo.label;
        // 묶음이면 아래에 점으로 몇 번째 사진인지 표시
        thumbs.replaceChildren(
          ...(photo.total > 1
            ? Array.from({ length: photo.total }, (_, n) => {
                const dot = document.createElement('span');
                dot.className = 'viewer-dot' + (n === photo.n ? ' is-current' : '');
                return dot;
              })
            : [])
        );
      };
      buttons.forEach((button, index) =>
        button.addEventListener('click', () => {
          show(flat.findIndex((p) => p.item === index));
          dialog.showModal();
        })
      );
      dialog.querySelector('[data-aw-gallery-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-aw-gallery-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      const loaded = () => img.classList.remove('is-loading');
      img.addEventListener('load', loaded);
      img.addEventListener('error', loaded);
      // 창을 닫으면 사진을 비워 둠 (다음에 열 때 이전 사진이 보이지 않게)
      dialog.addEventListener('close', () => {
        // 닫자마자 다른 사진을 열었으면(이미 다시 열려 있으면) 건드리지 않음
        if (dialog.open) return;
        img.removeAttribute('src');
        img.classList.add('is-loading');
      });
      // Click on the backdrop closes the viewer.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }
  if (!customElements.get('aw-gallery')) customElements.define('aw-gallery', AwGallery);
</script>
