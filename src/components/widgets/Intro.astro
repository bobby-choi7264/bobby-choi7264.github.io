---
// 첫 방문 때만 나오는 입장 화면.
// 먼저 도장과 '들어가기' 단추를 보여 줍니다. 브라우저는 사람이 한 번 누르기 전에는 소리를 막기 때문에,
// 단추를 누르는 순간 소리(SoundSystem.astro)와 연출이 함께 시작됩니다. '소리 없이'를 누르면 조용히 시작.
// 연출이 시작된 뒤 2초 동안은 넘길 수 없고, 그 뒤에는 누르면 바로 넘어가며, 가만히 두면 3.4초쯤 스스로 걷힙니다.
// 소리와 맞추려고 연출 시점마다 신호를 보냅니다: sc:intro-start(시작), sc:intro-stamp(도장), sc:intro-out(걷힘)
// 같은 방문(세션) 안에서는 다시 나오지 않습니다.
import Seal from '~/components/common/Seal.astro';
import { SHOP } from '~/data/shop';
import { langFromPath, useT } from '~/i18n';

const t = useT(langFromPath(Astro.url.pathname));
---

<script is:inline data-astro-rerun>
  try {
    if (sessionStorage.getItem('sc-intro-seen')) document.documentElement.classList.add('intro-done');
    else document.documentElement.classList.add('intro-active');
  } catch {
    document.documentElement.classList.add('intro-active');
  }
</script>
<noscript
  ><style>
    #intro {
      display: none;
    }
    .hero-reveal > * {
      opacity: 1 !important;
      transform: none !important;
    }
  </style></noscript
>

<div id="intro" class="wood-grain" role="dialog" aria-modal="true" aria-label={SHOP.name}>
  <div class="intro-gate" aria-hidden="false">
    <Seal class="intro-gate-seal text-3xl md:text-4xl" />
    <p class="mt-6 font-heading text-xl md:text-2xl text-[#f5ecde]" translate="no">{SHOP.name}</p>
    <p class="mt-2 text-[10px] md:text-xs tracking-[0.5em] pl-[0.5em] text-[#c49654]/80" translate="no">
      {SHOP.nameEn}
    </p>
    <button type="button" class="intro-enter mt-10" data-intro-enter="sound">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"
        ></path></svg
      >
      {t.intro.enterSound}
    </button>
    <button type="button" class="intro-quiet mt-4" data-intro-enter="quiet">{t.intro.enterQuiet}</button>
  </div>

  <div class="intro-stage flex flex-col items-center text-center px-6" aria-hidden="true">
    <div class="intro-line gold-rule mb-8"></div>
    <p class="intro-title font-heading text-4xl md:text-6xl font-bold pl-[0.35em]" translate="no">
      <span class="gold-text">{SHOP.name}</span>
    </p>
    <p class="intro-sub mt-6 text-xs md:text-sm tracking-[0.5em] text-[#c49654]/80 pl-[0.5em]">{SHOP.nameEn}</p>
    <p class="intro-sub mt-3 text-sm md:text-base text-[#e2d6c4]/70">{t.intro.sub}</p>
    <Seal class="intro-seal mt-8 text-lg md:text-xl" />
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.documentElement;
    const intro = document.getElementById('intro');
    if (!intro || !root.classList.contains('intro-active')) return;

    const LOCK_MS = 2000; // 연출이 시작된 뒤 이 시간 동안은 넘길 수 없음
    const STAMP_MS = 2280; // 도장이 종이에 닿는 순간 (tailwind.css의 sealStamp와 맞춤)
    const END_MS = 3400; // 걷히기 시작하는 시점 (tailwind.css의 introOut과 맞춤)
    const FONT_WAIT_MS = 2500; // 글꼴을 이보다 오래 기다리지는 않음
    let startedAt = 0;
    let finished = false;
    const timers = [];
    const signal = (name, detail) => document.dispatchEvent(new CustomEvent(name, { detail }));

    const block = (e) => {
      if (startedAt && e.cancelable) e.preventDefault();
    };
    const finish = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      try {
        sessionStorage.setItem('sc-intro-seen', '1');
      } catch {
        /* storage unavailable */
      }
      root.classList.remove('intro-active');
      root.classList.add('intro-reveal', 'intro-done');
      window.removeEventListener('touchmove', block);
      window.removeEventListener('wheel', block);
      window.removeEventListener('keydown', onKey, true);
      signal('sc:intro-out');
    };
    const trySkip = () => {
      if (startedAt && performance.now() - startedAt >= LOCK_MS) finish();
    };
    // 단추를 고르는 동안에는 키보드(Tab·Enter)를 막지 않음
    const onKey = (e) => {
      if (!startedAt) return;
      block(e);
      trySkip();
    };

    window.addEventListener('touchmove', block, { passive: false });
    window.addEventListener('wheel', block, { passive: false });
    window.addEventListener('keydown', onKey, true);
    intro.addEventListener('click', trySkip);

    const start = (withSound) => {
      if (startedAt || finished) return;
      startedAt = performance.now();
      signal('sc:intro-start', { sound: withSound });
      intro.classList.remove('gate');
      intro.classList.add('play');
      timers.push(setTimeout(() => signal('sc:intro-stamp'), STAMP_MS));
      // 입장 화면이 걷히기 시작하면 첫 화면 글자가 올라오기 시작
      timers.push(setTimeout(() => root.classList.add('intro-reveal'), END_MS));
      timers.push(setTimeout(finish, END_MS + 900));
    };

    intro.querySelectorAll('[data-intro-enter]').forEach((button) =>
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        start(button.dataset.introEnter === 'sound');
      })
    );

    // 글꼴이 준비되면 입장 단추를 보여 줌
    const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
    Promise.race([fontsReady, new Promise((r) => setTimeout(r, FONT_WAIT_MS))]).then(() => {
      if (startedAt || finished) return;
      intro.classList.add('gate');
      intro.querySelector('[data-intro-enter="sound"]')?.focus({ preventScroll: true });
    });
  })();
</script>
