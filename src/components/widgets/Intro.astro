---
// 첫 방문 때만 나오는 입장 화면.
// 글꼴이 준비된 뒤에 연출을 시작하고(휴대폰에서 글자가 늦게 자리 잡는 문제 방지),
// 시작 후 2초 동안은 터치·스크롤·키 입력을 막습니다. 그 뒤에는 누르면 바로 넘어가고,
// 가만히 두면 3.4초쯤 스스로 걷힙니다. 같은 방문(세션) 안에서는 다시 나오지 않습니다.
import Seal from '~/components/common/Seal.astro';
import { SHOP } from '~/data/shop';
---

<script is:inline data-astro-rerun>
  try {
    if (sessionStorage.getItem('sc-intro-seen')) document.documentElement.classList.add('intro-done');
    else document.documentElement.classList.add('intro-active');
  } catch {
    document.documentElement.classList.add('intro-active');
  }
</script>
<noscript
  ><style>
    #intro {
      display: none;
    }
    .hero-reveal > * {
      opacity: 1 !important;
      transform: none !important;
    }
  </style></noscript
>

<div id="intro" class="wood-grain" role="presentation" aria-hidden="true">
  <div class="flex flex-col items-center text-center px-6">
    <div class="intro-line gold-rule mb-8"></div>
    <p class="intro-title font-heading text-4xl md:text-6xl font-bold pl-[0.35em]">
      <span class="gold-text">{SHOP.name}</span>
    </p>
    <p class="intro-sub mt-6 text-xs md:text-sm tracking-[0.5em] text-[#c49654]/80 pl-[0.5em]">{SHOP.nameEn}</p>
    <p class="intro-sub mt-3 text-sm md:text-base text-[#e2d6c4]/70">55년, 나무를 돌려 깎아 쓰임을 만듭니다</p>
    <Seal class="intro-seal mt-8 text-lg md:text-xl" />
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.documentElement;
    const intro = document.getElementById('intro');
    if (!intro || !root.classList.contains('intro-active')) return;

    const LOCK_MS = 2000; // 이 시간 동안은 넘길 수 없음
    const END_MS = 3400; // 걷히기 시작하는 시점 (tailwind.css의 introOut과 맞춤)
    const FONT_WAIT_MS = 2500; // 글꼴을 이보다 오래 기다리지는 않음
    let startedAt = 0;
    let finished = false;

    const block = (e) => {
      if (e.cancelable) e.preventDefault();
    };
    const finish = () => {
      if (finished) return;
      finished = true;
      try {
        sessionStorage.setItem('sc-intro-seen', '1');
      } catch {
        /* storage unavailable */
      }
      root.classList.remove('intro-active');
      root.classList.add('intro-reveal', 'intro-done');
      window.removeEventListener('touchmove', block);
      window.removeEventListener('wheel', block);
      window.removeEventListener('keydown', onKey, true);
    };
    const trySkip = () => {
      if (startedAt && performance.now() - startedAt >= LOCK_MS) finish();
    };
    const onKey = (e) => {
      block(e);
      trySkip();
    };

    window.addEventListener('touchmove', block, { passive: false });
    window.addEventListener('wheel', block, { passive: false });
    window.addEventListener('keydown', onKey, true);
    intro.addEventListener('click', trySkip);

    const start = () => {
      if (startedAt || finished) return;
      startedAt = performance.now();
      intro.classList.add('play');
      // 입장 화면이 걷히기 시작하면 첫 화면 글자가 올라오기 시작
      setTimeout(() => root.classList.add('intro-reveal'), END_MS);
      setTimeout(finish, END_MS + 900);
    };
    const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
    Promise.race([fontsReady, new Promise((r) => setTimeout(r, FONT_WAIT_MS))]).then(() => {
      requestAnimationFrame(start);
      // 화면 그리기가 늦는 브라우저(일부 앱 안 브라우저 등)에서도 반드시 시작되도록
      setTimeout(start, 400);
    });
    // 어떤 경우에도 입장 화면에 갇히지 않도록 마지막 안전장치
    setTimeout(finish, FONT_WAIT_MS + 400 + END_MS + 900 + 1500);
  })();
</script>
