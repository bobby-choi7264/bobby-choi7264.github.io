---
// 첫 방문 때만 나오는 입장 화면.
// 첫 화면과 같은 공방 사진을 어둡게 깔고 상호와 '화면을 누르면 입장합니다'를 보여 줍니다. 브라우저는 사람이 한 번 누르기 전에는 소리를 막기 때문에,
// 화면을 누르는(또는 키를 누르는) 순간 소리(SoundSystem.astro)와 연출이 함께 시작됩니다.
// 전에 소리를 꺼 둔 방문자는 소리 없이 시작합니다.
// 연출이 시작된 뒤 2초 동안은 넘길 수 없고, 그 뒤에는 누르면 바로 넘어가며, 가만히 두면 3.4초쯤 스스로 걷힙니다.
// 소리와 맞추려고 연출 시점마다 신호를 보냅니다: sc:intro-start(시작), sc:intro-stamp(큰 소리, 금선이 그어지는 때), sc:intro-out(걷힘)
// 걷힐 때 아래에 같은 사진의 첫 화면이 있어서 끊김 없이 이어집니다.
// 같은 방문(세션) 안에서는 다시 나오지 않습니다.
import Image from '~/components/common/Image.astro';
import { SHOP } from '~/data/shop';
import { HERO_SLIDES, pick } from '~/data/works';
import { langFromPath, useT } from '~/i18n';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
// 첫 화면 슬라이드쇼의 첫 사진과 똑같은 설정으로 불러와서 같은 파일을 한 번만 받음
const photo = pick(HERO_SLIDES, lang)[0];
const chars = [...SHOP.name];
---

<script is:inline data-astro-rerun>
  try {
    if (sessionStorage.getItem('sc-intro-seen')) document.documentElement.classList.add('intro-done');
    else document.documentElement.classList.add('intro-active');
  } catch {
    document.documentElement.classList.add('intro-active');
  }
</script>
<noscript
  ><style>
    #intro {
      display: none;
    }
    .hero-reveal > * {
      opacity: 1 !important;
      transform: none !important;
    }
  </style></noscript
>

<div id="intro" role="dialog" aria-modal="true" aria-label={SHOP.name}>
  <div class="intro-photo" aria-hidden="true">
    <Image
      src={photo.src}
      alt=""
      widths={[768, 1280, 1800]}
      sizes="100vw"
      width={1800}
      height={1000}
      layout="none"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="intro-shade" aria-hidden="true"></div>

  <div class="intro-gate">
    <p class="font-heading text-3xl md:text-4xl font-bold text-[#f8f1e6]" translate="no">{SHOP.name}</p>
    <p class="mt-3 text-[11px] md:text-xs tracking-[0.45em] pl-[0.45em] text-[#e0ba78]/85" translate="no">
      {SHOP.nameEn}
    </p>
    <p class="intro-tap mt-14 text-sm md:text-base text-[#efe6d8]/85">
      <span class="intro-tap-ring" aria-hidden="true"></span>{t.intro.enter}
    </p>
  </div>

  <div class="intro-stage flex flex-col items-center text-center px-6" aria-hidden="true">
    <p class="intro-kicker text-[11px] md:text-sm tracking-[0.45em] pl-[0.45em] text-[#e0ba78]" translate="no">
      {SHOP.nameEn}
    </p>
    <p class="intro-title mt-5 font-heading text-5xl md:text-7xl font-bold text-[#fbf6ee]" translate="no">
      {chars.map((char, i) => <span style={`--i:${i}`}>{char}</span>)}
    </p>
    <div class="intro-line mt-7"></div>
    <p class="intro-sub mt-6 text-sm md:text-lg text-[#efe6d8]/90">{t.intro.sub}</p>
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.documentElement;
    const intro = document.getElementById('intro');
    if (!intro || !root.classList.contains('intro-active')) return;

    const LOCK_MS = 2000; // 연출이 시작된 뒤 이 시간 동안은 넘길 수 없음
    const STAMP_MS = 2280; // 큰 소리가 나는 순간 = 금선이 그어지는 때 (tailwind.css의 introLine과 맞춤)
    const END_MS = 3400; // 걷히기 시작하는 시점 (tailwind.css의 introOut과 맞춤)
    const FONT_WAIT_MS = 2500; // 글꼴을 이보다 오래 기다리지는 않음
    let startedAt = 0;
    let finished = false;
    const timers = [];
    const signal = (name, detail) => document.dispatchEvent(new CustomEvent(name, { detail }));

    const block = (e) => {
      if (startedAt && e.cancelable) e.preventDefault();
    };
    const finish = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      try {
        sessionStorage.setItem('sc-intro-seen', '1');
      } catch {
        /* storage unavailable */
      }
      root.classList.remove('intro-active');
      root.classList.add('intro-reveal', 'intro-done');
      window.removeEventListener('touchmove', block);
      window.removeEventListener('wheel', block);
      window.removeEventListener('keydown', onKey, true);
      window.removeEventListener('keydown', enter, true);
      signal('sc:intro-out');
    };
    const trySkip = () => {
      if (startedAt && performance.now() - startedAt >= LOCK_MS) finish();
    };
    // 단추를 고르는 동안에는 키보드(Tab·Enter)를 막지 않음
    const onKey = (e) => {
      if (!startedAt) return;
      block(e);
      trySkip();
    };

    window.addEventListener('touchmove', block, { passive: false });
    window.addEventListener('wheel', block, { passive: false });
    window.addEventListener('keydown', onKey, true);
    intro.addEventListener('click', trySkip);

    const start = (withSound) => {
      if (startedAt || finished) return;
      startedAt = performance.now();
      signal('sc:intro-start', { sound: withSound });
      intro.classList.remove('gate');
      intro.classList.add('play');
      timers.push(setTimeout(() => signal('sc:intro-stamp'), STAMP_MS));
      // 입장 화면이 걷히기 시작하면 첫 화면 글자가 올라오기 시작
      timers.push(setTimeout(() => root.classList.add('intro-reveal'), END_MS));
      timers.push(setTimeout(finish, END_MS + 900));
    };

    // 입장: 화면 아무 곳이나 누르거나 키를 누르면 시작 (전에 소리를 꺼 둔 분은 조용히)
    const enter = (e) => {
      if (startedAt || finished || !intro.classList.contains('gate')) return;
      if (e.type === 'keydown' && ['Tab', 'Shift', 'Alt', 'Control', 'Meta'].includes(e.key)) return;
      if (e.cancelable) e.preventDefault();
      e.stopPropagation();
      let soundOff = false;
      try {
        soundOff = localStorage.getItem('sc-sound') === 'off';
      } catch {
        /* storage unavailable */
      }
      start(!soundOff);
    };
    intro.addEventListener('click', enter);
    window.addEventListener('keydown', enter, true);

    // 글꼴이 준비되면 입장 단추를 보여 줌
    const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
    Promise.race([fontsReady, new Promise((r) => setTimeout(r, FONT_WAIT_MS))]).then(() => {
      if (startedAt || finished) return;
      intro.classList.add('gate');
    });
  })();
</script>
