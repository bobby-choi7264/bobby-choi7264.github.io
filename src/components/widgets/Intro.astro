---
// 첫 방문 때만 나오는 입장 화면.
// 첫 화면과 같은 공방 사진을 어둡게 깔고 상호와 '화면을 누르면 입장합니다'를 보여 줍니다. 브라우저는 사람이 한 번 누르기 전에는 소리를 막기 때문에,
// 화면을 누르는(또는 키를 누르는) 순간 소리(SoundSystem.astro)와 연출이 함께 시작됩니다.
// 전에 소리를 꺼 둔 방문자는 소리 없이 시작합니다.
// 연출이 시작된 뒤 2초 동안은 넘길 수 없고, 그 뒤에는 누르면 바로 넘어가며, 가만히 두면 3.4초쯤 스스로 걷힙니다.
// 소리와 맞추려고 연출 시점마다 신호를 보냅니다: sc:intro-start(시작), sc:intro-stamp(큰 소리, 금선이 그어지는 때), sc:intro-out(걷힘)
// 걷힐 때 아래에 같은 사진의 첫 화면이 있어서 끊김 없이 이어집니다.
// 같은 방문(세션) 안에서는 다시 나오지 않습니다.
import Image from '~/components/common/Image.astro';
import BrandCrown from '~/components/common/BrandCrown.astro';
import Mark from '~/components/common/Mark.astro';
import { SHOP } from '~/data/shop';
import { HERO_RIGHT, HERO_SLIDES, HERO_TALL, pick } from '~/data/works';
import { langFromPath, useT } from '~/i18n';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
// 첫 화면 슬라이드쇼의 첫 사진과 똑같은 설정으로 불러와서 같은 파일을 한 번만 받음
const photo = pick(HERO_SLIDES, lang)[0];
const tall = HERO_TALL.includes(photo.file);
const right = HERO_RIGHT.includes(photo.file);
const chars = [...SHOP.name];
// 누르기 전 배경: 같은 자리에서 찍은 '로구로 위에서 깎이는 나무' 사진들을 천천히 겹쳐 넘겨 타임랩스처럼 보이게 함
// (tailwind.css의 .intro-reel — 5장 기준으로 맞춰 둠. 사진 수를 바꾸면 그쪽 reelFade·reelDrift의 %도 고칠 것)
const reel = pick(['column-123', 'column-16', 'column-14', 'column-122', 'column-115'], lang);
---

<script is:inline data-astro-rerun>
  try {
    if (sessionStorage.getItem('sc-intro-seen')) document.documentElement.classList.add('intro-done');
    else document.documentElement.classList.add('intro-active');
  } catch {
    document.documentElement.classList.add('intro-active');
  }
</script>
<noscript
  ><style>
    #intro {
      display: none;
    }
    .hero-reveal > * {
      opacity: 1 !important;
      transform: none !important;
    }
  </style></noscript
>

<div id="intro" role="dialog" aria-modal="true" aria-label={SHOP.name}>
  <div class:list={['intro-photo', tall && 'is-tall', right && 'is-right']} aria-hidden="true">
    {
      tall && (
        <div class="photo-fill">
          <Image
            src={photo.src}
            alt=""
            widths={[768]}
            sizes="100vw"
            width={768}
            height={1365}
            layout="none"
            format="webp"
            loading="eager"
          />
        </div>
      )
    }
    <Image
      src={photo.src}
      alt=""
      {...tall
        ? { widths: [768, 1012], sizes: '57vh', width: 1012, height: 1800 }
        : {
            widths: [768, 1280, 1800],
            sizes: right ? '(max-aspect-ratio: 1/1) 178vh, 100vw' : '100vw',
            width: 1800,
            height: 1000,
          }}
      layout="none"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="intro-reel" aria-hidden="true" style={`--n:${reel.length}`}>
    {
      reel.map((item, i) => (
        <div class="intro-reel-slide" style={`--i:${i}`}>
          <Image
            src={item.src}
            alt=""
            widths={[768, 1280]}
            sizes="100vw"
            width={1280}
            height={711}
            layout="none"
            format="webp"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        </div>
      ))
    }
  </div>
  <div class="intro-shade" aria-hidden="true"></div>
  <div class="intro-beam" aria-hidden="true"></div>
  <canvas class="intro-dust" aria-hidden="true"></canvas>
  <div class="intro-grain" aria-hidden="true"></div>

  <div class="intro-gate">
    <Mark class="mb-5 h-12 w-12 text-[#e0ba78]" />
    <div class="inline-flex flex-col gap-3">
      <BrandCrown class="text-xl md:text-2xl text-[#f3d9a4]" />
      <p class="font-heading text-3xl md:text-4xl font-bold text-[#f8f1e6] tracking-[0.06em]" translate="no">
        {SHOP.name}
      </p>
    </div>
    <p class="mt-3 text-[11px] md:text-xs tracking-[0.45em] pl-[0.45em] text-[#e0ba78]/85" translate="no">
      {SHOP.nameEn}
    </p>
    <p class="intro-tap mt-14 text-sm md:text-base text-[#efe6d8]/85">
      <span class="intro-tap-ring" aria-hidden="true"></span>{t.intro.enter}
    </p>
  </div>

  <div class="intro-stage flex flex-col items-center text-center px-6" aria-hidden="true">
    <Mark class="intro-mark mb-6 h-14 w-14 md:h-16 md:w-16 text-[#e0ba78]" />
    <p class="intro-kicker text-[11px] md:text-sm tracking-[0.45em] pl-[0.45em] text-[#e0ba78]" translate="no">
      {SHOP.nameEn}
    </p>
    <div class="mt-6 inline-flex flex-col gap-4 md:gap-5">
      <BrandCrown class="intro-crown text-3xl md:text-5xl text-[#f3d9a4]" />
      <p class="intro-title font-heading text-5xl md:text-7xl font-bold text-[#fbf6ee]" translate="no">
        {chars.map((char, i) => <span style={`--i:${i}`}>{char}</span>)}
      </p>
    </div>
    <div class="intro-line mt-7"></div>
    <p class="intro-sub mt-6 text-sm md:text-lg text-[#efe6d8]/90">{t.intro.sub}</p>
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.documentElement;
    const intro = document.getElementById('intro');
    if (!intro || !root.classList.contains('intro-active')) return;

    const LOCK_MS = 2000; // 연출이 시작된 뒤 이 시간 동안은 넘길 수 없음
    const STAMP_MS = 2280; // 큰 소리가 나는 순간 = 금선이 그어지는 때 (tailwind.css의 introLine과 맞춤)
    const END_MS = 3400; // 걷히기 시작하는 시점 (tailwind.css의 introOut과 맞춤)
    const FONT_WAIT_MS = 2500; // 글꼴을 이보다 오래 기다리지는 않음
    let startedAt = 0;
    let finished = false;
    const timers = [];
    const signal = (name, detail) => document.dispatchEvent(new CustomEvent(name, { detail }));

    // 입장 화면이 떠 있는 동안은(누르기 전·후 모두) 위아래로 끌어도 뒤 페이지가 움직이지 않게 막음.
    // 막지 않으면 휴대폰 주소창이 줄었다 늘었다 하며 화면 높이가 바뀌어 배경이 튀어 보임
    const block = (e) => {
      if (e.cancelable) e.preventDefault();
    };
    const finish = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      try {
        sessionStorage.setItem('sc-intro-seen', '1');
      } catch {
        /* storage unavailable */
      }
      root.classList.remove('intro-active');
      root.classList.add('intro-reveal', 'intro-done');
      document.removeEventListener('touchmove', block, true);
      document.removeEventListener('gesturestart', block, true);
      window.removeEventListener('wheel', block);
      window.removeEventListener('keydown', onKey, true);
      window.removeEventListener('keydown', enter, true);
      signal('sc:intro-out');
    };
    const trySkip = () => {
      if (startedAt && performance.now() - startedAt >= LOCK_MS) finish();
    };
    // 단추를 고르는 동안에는 키보드(Tab·Enter)를 막지 않음
    const onKey = (e) => {
      if (!startedAt) return;
      if (e.cancelable) e.preventDefault();
      trySkip();
    };

    document.addEventListener('touchmove', block, { passive: false, capture: true });
    document.addEventListener('gesturestart', block, { passive: false, capture: true }); // iPhone 두 손가락 확대
    window.addEventListener('wheel', block, { passive: false });
    window.addEventListener('keydown', onKey, true);
    intro.addEventListener('click', trySkip);

    const start = (withSound) => {
      if (startedAt || finished) return;
      startedAt = performance.now();
      signal('sc:intro-start', { sound: withSound });
      intro.classList.remove('gate');
      intro.classList.add('play');
      timers.push(setTimeout(() => signal('sc:intro-stamp'), STAMP_MS));
      // 입장 화면이 걷히기 시작하면 첫 화면 글자가 올라오기 시작
      timers.push(setTimeout(() => root.classList.add('intro-reveal'), END_MS));
      timers.push(setTimeout(finish, END_MS + 900));
    };

    // 입장: 화면 아무 곳이나 누르거나 키를 누르면 시작 (전에 소리를 꺼 둔 분은 조용히)
    const enter = (e) => {
      if (startedAt || finished || !intro.classList.contains('gate')) return;
      if (e.type === 'keydown' && ['Tab', 'Shift', 'Alt', 'Control', 'Meta'].includes(e.key)) return;
      if (e.cancelable) e.preventDefault();
      e.stopPropagation();
      let soundOff = false;
      try {
        soundOff = localStorage.getItem('sc-sound') === 'off';
      } catch {
        /* storage unavailable */
      }
      start(!soundOff);
    };
    intro.addEventListener('click', enter);
    window.addEventListener('keydown', enter, true);

    // 글꼴이 준비되면 입장 단추를 보여 줌
    const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
    Promise.race([fontsReady, new Promise((r) => setTimeout(r, FONT_WAIT_MS))]).then(() => {
      if (startedAt || finished) return;
      intro.classList.add('gate');
    });
  })();
</script>

<script is:inline data-astro-rerun>
  // 입장 화면의 떠다니는 먼지(작업등 빛 속에서 반짝임)와 가끔 튀는 고운 대팻밥
  (() => {
    const root = document.documentElement;
    const intro = document.getElementById('intro');
    const canvas = intro && intro.querySelector('.intro-dust');
    if (!canvas || !root.classList.contains('intro-active')) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0;
    let h = 0;
    let motes = [];
    const chips = [];
    const rand = (a, b) => a + Math.random() * (b - a);
    const newMote = (y) => ({
      x: rand(0, w),
      y: y ?? rand(0, h),
      r: rand(0.5, 1.9),
      vx: rand(-6, 6),
      vy: rand(-14, -3), // 따뜻한 공기를 타고 천천히 올라감 (초당 px)
      a: rand(0.25, 0.85),
      ph: rand(0, Math.PI * 2),
    });
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const nw = canvas.clientWidth;
      const nh = canvas.clientHeight;
      if (nw === w && nh === h) return;
      const widthChanged = nw !== w;
      w = nw;
      h = nh;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // 높이만 조금 바뀐 경우(휴대폰 주소창)는 먼지를 새로 뿌리지 않고 그대로 이어감
      if (widthChanged || !motes.length) {
        const count = Math.round(Math.min(90, (w * h) / 14000));
        motes = Array.from({ length: count }, () => newMote());
      }
    };
    // 작업등 빛줄기(.intro-beam과 같은 방향): 왼쪽 위에서 오른쪽 아래로. 빛 안에 있는 먼지일수록 밝게
    const inBeam = (x, y) => {
      const ax = w * 0.22;
      const ay = -h * 0.1;
      const dx = 0.5;
      const dy = 0.866;
      const px = x - ax;
      const py = y - ay;
      const dist = Math.abs(px * dy - py * dx);
      const spread = Math.max(w, h) * (0.12 + 0.18 * Math.max(0, (px * dx + py * dy) / h));
      return Math.exp(-(dist * dist) / (2 * spread * spread));
    };
    // 대팻밥: 가운데(나무가 깎이는 높이)에서 몇 조각씩 튀었다가 떨어짐
    let nextBurst = 1200;
    const burst = () => {
      const ox = w * rand(0.4, 0.62);
      const oy = h * rand(0.5, 0.58);
      const n = Math.round(rand(3, 7));
      for (let k = 0; k < n; k++) {
        chips.push({
          x: ox + rand(-12, 12),
          y: oy + rand(-6, 6),
          vx: rand(-90, 90),
          vy: rand(-170, -60),
          len: rand(2, 5),
          rot: rand(0, Math.PI),
          vr: rand(-12, 12),
          life: 0,
          max: rand(0.9, 1.6),
        });
      }
    };

    let last = performance.now();
    let elapsed = 0;
    let raf = 0;
    const frame = (now) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      elapsed += dt * 1000;
      ctx.clearRect(0, 0, w, h);

      for (const m of motes) {
        m.ph += dt * 0.8;
        m.x += (m.vx + Math.sin(m.ph) * 5) * dt;
        m.y += m.vy * dt;
        if (m.y < -4 || m.x < -4 || m.x > w + 4) Object.assign(m, newMote(h + 4));
        const glow = 0.12 + 0.88 * inBeam(m.x, m.y);
        const twinkle = 0.75 + 0.25 * Math.sin(m.ph * 2.3);
        ctx.globalAlpha = m.a * glow * twinkle;
        ctx.fillStyle = '#ffd9a6';
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (elapsed > nextBurst) {
        burst();
        nextBurst = elapsed + rand(1400, 3200);
      }
      ctx.lineCap = 'round';
      for (let k = chips.length - 1; k >= 0; k--) {
        const c = chips[k];
        c.life += dt;
        if (c.life > c.max) {
          chips.splice(k, 1);
          continue;
        }
        c.vy += 420 * dt;
        c.vx *= 0.985;
        c.x += c.vx * dt;
        c.y += c.vy * dt;
        c.rot += c.vr * dt;
        const t = c.life / c.max;
        ctx.globalAlpha = 0.55 * (t < 0.15 ? t / 0.15 : 1 - (t - 0.15) / 0.85);
        ctx.strokeStyle = '#ecd2a4';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(c.x - Math.cos(c.rot) * c.len, c.y - Math.sin(c.rot) * c.len);
        ctx.lineTo(c.x + Math.cos(c.rot) * c.len, c.y + Math.sin(c.rot) * c.len);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      if (root.classList.contains('intro-done')) return; // 입장 화면이 끝나면 멈춤
      raf = requestAnimationFrame(frame);
    };

    resize();
    window.addEventListener('resize', resize);
    raf = requestAnimationFrame(frame);
    document.addEventListener(
      'sc:intro-out',
      () => {
        setTimeout(() => {
          cancelAnimationFrame(raf);
          window.removeEventListener('resize', resize);
        }, 1200);
      },
      { once: true }
    );
  })();
</script>
