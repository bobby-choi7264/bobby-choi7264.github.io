---
// 작업 사진이 두 줄로 천천히 흘러가는 띠. 위아래는 자 눈금으로 테를 두릅니다.
// 마우스를 올리면 멈추고, 사진은 은은한 옛날 사진 색에서 제 색으로 돌아옵니다.
import Image from '~/components/common/Image.astro';
import { pick } from '~/data/works';
import { langFromPath } from '~/i18n';

export interface Props {
  rows: string[][];
}
const { rows } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---

<div class="ribbon ruler-frame" aria-hidden="true">
  {
    rows.map((files, rowIndex) => {
      const items = pick(files, lang);
      return (
        <div class:list={['ribbon-track', { 'ribbon-track--reverse': rowIndex % 2 === 1 }]}>
          {[0, 1].map(() =>
            items.map((item) => (
              <figure class="ribbon-item">
                <Image
                  src={item.src}
                  alt=""
                  widths={[320, 480]}
                  sizes="(max-width: 767px) 220px, 300px"
                  width={480}
                  height={360}
                  layout="cover"
                  format="webp"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
                <figcaption>{item.caption}</figcaption>
              </figure>
            ))
          )}
        </div>
      );
    })
  }
</div>

<style>
  .ribbon {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 22px 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ribbon-track {
    display: flex;
    gap: 14px;
    width: max-content;
    animation: ribbonMove 70s linear infinite;
  }
  .ribbon-track--reverse {
    animation-direction: reverse;
    animation-duration: 85s;
  }
  .ribbon:hover .ribbon-track {
    animation-play-state: paused;
  }
  @keyframes ribbonMove {
    to {
      transform: translateX(calc(-50% - 7px));
    }
  }
  .ribbon-item {
    position: relative;
    width: 220px;
    aspect-ratio: 4 / 3;
    flex: none;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid rgb(196 150 84 / 0.25);
    filter: sepia(0.35) saturate(0.85) brightness(0.85);
    transition: filter 0.5s ease;
  }
  .ribbon-item:hover {
    filter: none;
  }
  .ribbon-item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px 10px 8px;
    font-size: 12px;
    color: #f3e3c6;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .ribbon-item:hover figcaption {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 768px) {
    .ribbon-item {
      width: 300px;
    }
  }
</style>
