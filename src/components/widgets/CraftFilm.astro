---
// 첫 화면 아래 작업 영상. 파일은 public/video/ 에 있습니다 (영상은 바탕화면 원본을 편집해 만든 것).
// 재생을 누르면 소리와 함께 시작하고(영상 파일도 그때 받음), 화면 밖으로 나가면 멈춥니다.
// 소리를 켜면 SoundSystem.astro에 알려 배경음악을 쉽니다(sc:film-sound).
import { Icon } from 'astro-icon/components';
import { langFromPath, useT } from '~/i18n';

const t = useT(langFromPath(Astro.url.pathname)).film;
---

<section class="relative px-4 pt-16 pb-6 md:pt-24 md:pb-10">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 text-center md:mb-10">
      <p class="mb-3 text-sm tracking-[0.08em] text-primary">{t.tag}</p>
      <h2 class="font-heading text-3xl font-bold text-heading text-balance md:text-5xl" data-split>{t.title}</h2>
      <div class="ruler mx-auto my-6 max-w-md"></div>
      <p class="mx-auto max-w-2xl text-muted text-pretty">{t.lead}</p>
    </div>

    <figure
      class="craft-film relative aspect-video overflow-hidden rounded-xl border border-primary/25 bg-black shadow-2xl"
      data-craft-film
    >
      <video
        class="h-full w-full cursor-pointer object-cover"
        poster="/video/craft-film-poster.jpg"
        playsinline
        preload="none"
        aria-label={t.label}
      >
        <source src="/video/craft-film-mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
        <source src="/video/craft-film.mp4" type="video/mp4" />
      </video>
      <span class="film-bigplay" data-film-bigplay aria-hidden="true">
        <Icon name="tabler:player-play-filled" class="h-8 w-8" />
      </span>
    </figure>

    <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-3" data-film-controls>
      <button type="button" class="film-btn" data-film-toggle data-play={t.play} data-pause={t.pause}>
        <Icon name="tabler:player-play" class="film-icon-play h-5 w-5 shrink-0" />
        <Icon name="tabler:player-pause" class="film-icon-pause hidden h-5 w-5 shrink-0" />
        <span data-film-toggle-label>{t.play}</span>
      </button>
      <button type="button" class="film-btn" data-film-restart>
        <Icon name="tabler:player-skip-back" class="h-5 w-5 shrink-0" />
        <span>{t.restart}</span>
      </button>
      <button type="button" class="film-btn" data-film-sound data-on={t.soundOn} data-off={t.soundOff}>
        <Icon name="tabler:volume" class="film-icon-on h-5 w-5 shrink-0" />
        <Icon name="tabler:volume-off" class="film-icon-off hidden h-5 w-5 shrink-0" />
        <span data-film-sound-label>{t.soundOn}</span>
      </button>
      <div class="flex min-w-48 flex-1 items-center gap-2 basis-full sm:basis-48">
        <input
          type="range"
          class="film-seek min-w-0 flex-1"
          min="0"
          max="60"
          step="0.1"
          value="0"
          aria-label={t.seek}
          data-film-seek
        />
        <span class="shrink-0 text-xs tabular-nums text-muted" data-film-time>0:00 / 1:00</span>
      </div>
    </div>
  </div>
</section>

<style>
  .film-btn {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid rgb(196 150 84 / 0.45);
    padding: 0 0.85rem;
    color: var(--aw-color-text-heading);
    font-size: 0.875rem;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .film-btn:hover {
    border-color: var(--aw-color-primary);
    background: rgb(196 150 84 / 0.16);
  }
  .film-bigplay {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    place-items: center;
    border-radius: 9999px;
    background: rgb(20 15 11 / 0.72);
    border: 1px solid rgb(224 186 120 / 0.7);
    color: #f3d9a4;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.25s;
  }
  .film-bigplay.is-hidden {
    opacity: 0;
  }
  .film-seek {
    height: 2.75rem;
    accent-color: var(--aw-color-primary);
    cursor: pointer;
  }
</style>

<script>
  let cleanup: (() => void) | undefined;

  const setup = () => {
    cleanup?.();
    cleanup = undefined;
    const root = document.querySelector<HTMLElement>('[data-craft-film]');
    const controls = document.querySelector<HTMLElement>('[data-film-controls]');
    const video = root?.querySelector('video');
    const bigPlay = root?.querySelector<HTMLElement>('[data-film-bigplay]');
    const toggle = controls?.querySelector<HTMLButtonElement>('[data-film-toggle]');
    const restart = controls?.querySelector<HTMLButtonElement>('[data-film-restart]');
    const sound = controls?.querySelector<HTMLButtonElement>('[data-film-sound]');
    const seek = controls?.querySelector<HTMLInputElement>('[data-film-seek]');
    const time = controls?.querySelector<HTMLElement>('[data-film-time]');
    if (!root || !video || !bigPlay || !toggle || !restart || !sound || !seek || !time) return;

    let announced = false;
    let resumeOnReturn = false;
    let fadeTimer: number | undefined;
    let seeking = false;
    let leaving = false; // 화면 밖으로 나가 소리를 줄이는 중

    // 영상이 소리로 재생되는 동안 SoundSystem.astro가 배경음악을 끔 (sc:film-sound)
    const syncMusic = (force?: boolean) => {
      const on = force ?? (!leaving && !video.muted && !video.paused);
      if (on === announced) return;
      announced = on;
      document.dispatchEvent(new CustomEvent('sc:film-sound', { detail: { on } }));
    };
    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const renderTime = () => {
      const total = Number.isFinite(video.duration) ? video.duration : Number(seek.max);
      seek.max = String(total);
      if (!seeking) seek.value = String(video.currentTime);
      time.textContent = `${clock(video.currentTime)} / ${clock(total)}`;
    };
    const render = () => {
      const playing = !video.paused;
      const label = toggle.querySelector('[data-film-toggle-label]');
      if (label) label.textContent = (playing ? toggle.dataset.pause : toggle.dataset.play) ?? '';
      toggle.querySelector('.film-icon-play')?.classList.toggle('hidden', playing);
      toggle.querySelector('.film-icon-pause')?.classList.toggle('hidden', !playing);
      bigPlay.classList.toggle('is-hidden', playing);
      sound.querySelector('.film-icon-on')?.classList.toggle('hidden', !video.muted);
      sound.querySelector('.film-icon-off')?.classList.toggle('hidden', video.muted);
      const soundLabel = sound.querySelector('[data-film-sound-label]');
      if (soundLabel) soundLabel.textContent = (video.muted ? sound.dataset.on : sound.dataset.off) ?? '';
      syncMusic();
    };
    const play = () => {
      leaving = false;
      window.clearInterval(fadeTimer);
      video.volume = 1;
      video.play().catch(() => render());
    };
    // 화면 밖으로 나갈 때 소리를 짧게 줄이고 멈춤 (iPhone은 음량을 코드로 못 바꿔서 바로 멈춤)
    const fadeOutAndPause = () => {
      window.clearInterval(fadeTimer);
      const from = video.volume;
      const started = performance.now();
      fadeTimer = window.setInterval(() => {
        const p = Math.min(1, (performance.now() - started) / 400);
        video.volume = from * (1 - p);
        if (p < 1) return;
        window.clearInterval(fadeTimer);
        video.pause();
        video.volume = 1;
      }, 40);
    };

    // 화면 밖으로 나가면 정지하고 배경음악을 되살림. 다시 와도 저절로 재생하지 않음
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting || video.paused) return;
        leaving = true;
        syncMusic();
        if (video.muted) video.pause();
        else fadeOutAndPause();
      },
      { threshold: 0.35 }
    );
    io.observe(root);

    const onToggle = () => {
      if (video.paused) play();
      else video.pause();
    };
    const onRestart = () => {
      video.currentTime = 0;
      renderTime();
      play();
    };
    const onSound = () => {
      video.muted = !video.muted;
      render();
    };
    const onSeekInput = () => {
      seeking = true;
      video.currentTime = Number(seek.value);
      time.textContent = `${clock(Number(seek.value))} / ${clock(Number(seek.max))}`;
    };
    const onSeekEnd = () => {
      seeking = false;
    };
    const onHidden = () => {
      if (document.hidden) {
        resumeOnReturn = !video.paused;
        video.pause();
      } else if (resumeOnReturn) {
        resumeOnReturn = false;
        play();
      }
    };
    toggle.addEventListener('click', onToggle);
    video.addEventListener('click', onToggle);
    restart.addEventListener('click', onRestart);
    sound.addEventListener('click', onSound);
    seek.addEventListener('input', onSeekInput);
    seek.addEventListener('change', onSeekEnd);
    video.addEventListener('play', render);
    video.addEventListener('pause', render);
    video.addEventListener('ended', render);
    video.addEventListener('volumechange', render);
    video.addEventListener('timeupdate', renderTime);
    video.addEventListener('loadedmetadata', renderTime);
    document.addEventListener('visibilitychange', onHidden);
    render();

    cleanup = () => {
      io.disconnect();
      window.clearInterval(fadeTimer);
      toggle.removeEventListener('click', onToggle);
      restart.removeEventListener('click', onRestart);
      sound.removeEventListener('click', onSound);
      seek.removeEventListener('input', onSeekInput);
      seek.removeEventListener('change', onSeekEnd);
      document.removeEventListener('visibilitychange', onHidden);
      syncMusic(false);
      video.pause();
    };
  };

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
