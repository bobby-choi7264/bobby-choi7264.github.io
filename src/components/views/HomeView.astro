---
// 홈 화면. 한국어(/)와 다른 언어(/en/ 등) 페이지가 함께 씁니다.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Intro from '~/components/widgets/Intro.astro';
import HeroShowcase from '~/components/widgets/HeroShowcase.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import PhotoRibbon from '~/components/widgets/PhotoRibbon.astro';
import CraftProcess from '~/components/widgets/CraftProcess.astro';
import Seal from '~/components/common/Seal.astro';
import Image from '~/components/common/Image.astro';
import { SITE } from 'astrowind:config';
import { SERVICES, shopFor } from '~/data/shop';
import { FEATURED, GALLERY_COUNT, pick } from '~/data/works';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const h = t.home;
const shop = shopFor(lang);

const metadata = {
  title: h.metaTitle,
  description: h.metaDescription,
  ignoreTitleTemplate: true,
};

const serviceImages: Record<string, string> = {
  lathe: '~/assets/images/works/lathe-56.jpg',
  column: '~/assets/images/works/column-13.jpg',
  custom: '~/assets/images/works/custom-40.jpg',
  furniture: '~/assets/images/works/furniture-57.jpg',
};

// 검색엔진에 가게 정보를 알려 주는 구조화 데이터 (주소·전화·영업시간)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE?.site}/#business`,
  name: lang === 'ko' ? shop.name : `${shop.name} (${shop.nameEn})`,
  url: SITE?.site,
  telephone: ['+82-2-2292-0062', '+82-10-8548-7264'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '을지로 219',
    addressLocality: '중구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
};

const benchPhotos = [
  { src: '~/assets/images/works/column-14.jpg', cls: 'col-span-2 aspect-[16/10]', w: 800, h: 500 },
  { src: '~/assets/images/works/workshop-08.jpg', cls: 'aspect-square', w: 480, h: 480 },
  { src: '~/assets/images/works/lathe-27.jpg', cls: 'aspect-square', w: 480, h: 480 },
];
const NUMS = ['壹', '貳', '參', '肆'];
const PRINCIPLE_NUMS = ['一', '二', '三'];
---

<Layout metadata={metadata} lang={lang}>
  <StructuredData slot="head" schema={structuredData} />
  <Intro />
  <HeroShowcase />

  <!-- 작업 분야 -->
  <section id="services" class="relative px-4 py-20 md:py-28 scroll-mt-16">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">{h.servicesTag}</p>
        <h2 class="font-heading text-3xl md:text-5xl font-bold text-heading text-balance" data-split>
          {h.servicesTitle}
        </h2>
        <div class="ruler mx-auto my-6 max-w-md"></div>
        <p class="text-muted max-w-2xl mx-auto text-pretty">{h.servicesLead}</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {
          SERVICES.map((service, index) => {
            const s = t.services[service.key];
            return (
              <a
                href={localize(lang, `/services#${service.key}`)}
                class="service-card group relative overflow-hidden rounded-xl border border-primary/20 min-h-[22rem] sm:min-h-0 sm:aspect-[16/10] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                data-tilt
              >
                <Image
                  src={serviceImages[service.key]}
                  alt=""
                  widths={[640, 960]}
                  sizes="(max-width: 639px) 100vw, 50vw"
                  width={960}
                  height={600}
                  layout="cover"
                  format="webp"
                  class="photo-tone absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/70 to-black/10 sm:from-black/90 sm:via-black/45 sm:to-black/5" />
                <span class="corner-marks" aria-hidden="true" />
                <span
                  class="absolute right-5 top-4 font-heading text-4xl md:text-5xl font-black text-primary/25 transition-colors duration-500 group-hover:text-primary/60"
                  aria-hidden="true"
                >
                  {NUMS[index]}
                </span>
                <div class="absolute bottom-0 p-6 md:p-8">
                  <Icon name={service.icon} class="w-8 h-8 text-primary mb-3" />
                  <h3 class="font-heading text-2xl font-bold text-heading">{s.title}</h3>
                  <p class="mt-2 text-sm md:text-base text-default/85 text-pretty">{s.description}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm text-primary opacity-80 transition group-hover:gap-2 group-hover:opacity-100">
                    {t.nav.services}
                    <Icon name="tabler:arrow-right" class="h-4 w-4" />
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
      <p class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a
          href={localize(lang, '/services#cases')}
          class="inline-flex min-h-11 items-center gap-1 text-primary hover:underline"
        >
          {t.servicesPage.casesTitle}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
        <a href={localize(lang, '/woods')} class="inline-flex min-h-11 items-center gap-1 text-primary hover:underline">
          {t.nav.woods}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </p>
    </div>
  </section>

  <!-- 흘러가는 작업 사진 -->
  <section class="py-16 md:py-20">
    <div class="px-4 text-center mb-8">
      <p class="text-sm tracking-[0.3em] text-primary mb-3">{h.ribbonTag}</p>
      <h2 class="font-heading text-2xl md:text-4xl font-bold text-heading text-balance" data-split>{h.ribbonTitle}</h2>
    </div>
    <PhotoRibbon
      rows={[
        [
          'lathe-85',
          'lathe-79',
          'lathe-28',
          'lathe-21',
          'lathe-56',
          'lathe-55',
          'lathe-50',
          'lathe-03',
          'lathe-23',
          'lathe-88',
          'lathe-73',
          'lathe-82',
        ],
        [
          'column-13',
          'custom-40',
          'column-36',
          'furniture-57',
          'column-37',
          'custom-53',
          'column-26',
          'furniture-42',
          'column-17',
          'custom-87',
          'column-29',
          'furniture-22',
        ],
      ]}
    />
  </section>

  <!-- 장인의 작업대 -->
  <section class="relative px-4 py-20 md:py-28 border-y border-primary/15 bg-dark overflow-hidden">
    <span class="hanja-mark -right-8 -top-10 text-[16rem] md:text-[26rem]" aria-hidden="true">匠</span>
    <div class="relative max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 items-center">
      <div class="grid grid-cols-2 gap-3">
        {
          benchPhotos.map((photo, i) => (
            <div
              class={`relative overflow-hidden rounded-lg border border-primary/20 reveal-wipe intersect intersect-once intersect-quarter ${photo.cls}`}
            >
              <Image
                src={photo.src}
                alt={h.benchAlts[i]}
                widths={i === 0 ? [480, 800] : [320, 480]}
                sizes={i === 0 ? '(max-width: 1023px) 100vw, 560px' : '(max-width: 1023px) 50vw, 280px'}
                width={photo.w}
                height={photo.h}
                layout="cover"
                format="webp"
                class="photo-tone h-full w-full object-cover"
              />
              <span class="corner-marks" aria-hidden="true" />
            </div>
          ))
        }
      </div>

      <div>
        <p class="font-heading font-bold leading-none mb-2">
          <span class="gold-text text-7xl md:text-8xl tabular-nums" data-count-to="55">55</span><span
            class="text-3xl md:text-4xl text-primary ml-1">{h.yearsUnit}</span
          >
        </p>
        <h2 class="text-sm tracking-[0.3em] text-primary mb-8 font-normal">{h.benchTag}</h2>
        <blockquote class="font-heading text-2xl md:text-4xl font-bold leading-snug text-heading text-balance">
          {h.quote1}<br /><span class="gold-text">{h.quote2}</span>
        </blockquote>
        <a href={localize(lang, '/about')} class="mt-6 inline-flex items-center gap-3 group">
          <Image
            src="~/assets/images/owner/craftsman.jpg"
            alt=""
            widths={[112]}
            width={112}
            height={112}
            layout="fixed"
            format="webp"
            class="h-14 w-14 rounded-full object-cover object-[50%_45%] border border-primary/50"
          />
          <span class="font-heading text-primary group-hover:underline">— {h.quoteBy}</span>
        </a>
        <div class="gold-rule my-8 max-w-xs"></div>
        <ol class="space-y-6">
          {
            h.principles.map((p, i) => (
              <li
                class="flex gap-5 intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
                style={`animation-delay:${i * 0.15}s`}
              >
                <span class="font-heading text-3xl font-bold text-primary/70 leading-none">{PRINCIPLE_NUMS[i]}</span>
                <div>
                  <h3 class="font-heading text-xl font-bold text-heading">{p.title}</h3>
                  <p class="mt-1 text-muted text-pretty">{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CraftProcess />

  <!-- 대표 작업 -->
  <Gallery id="works" columns={4} images={pick(FEATURED, lang)}>
    <Fragment slot="tagline">{h.featuredTag}</Fragment>
    <Fragment slot="title">{h.featuredTitle}</Fragment>
    <Fragment slot="subtitle">{h.featuredLead}</Fragment>
  </Gallery>
  <div class="text-center -mt-6 mb-20 px-4">
    <a href={localize(lang, '/works')} class="btn border-primary/60 text-heading hover:bg-primary/15">
      {h.allWorks(GALLERY_COUNT)}
      <Icon name="tabler:arrow-right" class="w-5 h-5 ml-2" />
    </a>
  </div>

  <!-- 주문 안내 -->
  <section class="relative px-4 py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/column-04.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={900}
        layout="cover"
        format="webp"
        class="h-full w-full object-cover parallax-img"
      />
      <div class="absolute inset-0 bg-black/75"></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <Seal class="stamp-in mb-6 text-lg intersect intersect-once intersect-half" />
      <p class="text-sm tracking-[0.3em] text-primary mb-3">{h.orderTag}</p>
      <h2 class="font-heading text-3xl md:text-5xl font-bold text-heading text-balance" data-split>{h.orderTitle}</h2>
      <p class="mt-6 text-lg text-default/90 text-pretty">{h.orderLead}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={localize(lang, '/contact')} class="btn-primary"
          ><Icon name="tabler:clipboard-text" class="w-5 h-5 mr-2" />{h.orderForm}</a
        >
        <a href={shop.tel.href} class="btn border-primary/60 text-heading hover:bg-primary/15"
          ><Icon name="tabler:phone" class="w-5 h-5 mr-2" />{shop.tel.label}</a
        >
        <a href={shop.mobile.sms} class="btn border-white/30 text-heading hover:bg-white/10"
          ><Icon name="tabler:message" class="w-5 h-5 mr-2" />{h.sendPhoto}</a
        >
      </div>
      <p class="mt-6 text-sm">
        <a
          href={localize(lang, '/contact#faq')}
          class="inline-flex min-h-11 items-center text-primary underline underline-offset-4 hover:text-accent"
          >{t.faq.title}</a
        >
      </p>
    </div>
  </section>

  {
    lang === 'ko' && (
      <BlogLatestPosts count={3} linkText={h.newsAll}>
        <Fragment slot="title">{h.newsTitle}</Fragment>
      </BlogLatestPosts>
    )
  }

  <!-- 을지로 작업장 -->
  <section class="relative overflow-hidden py-28 md:py-40 px-4">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/workshop-47.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={900}
        layout="cover"
        format="webp"
        class="h-full w-full object-cover parallax-img sepia-[0.3]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/30"></div>
    </div>
    <div class="relative max-w-6xl mx-auto">
      <p class="text-sm tracking-[0.3em] text-primary mb-4">{shop.addressShort}</p>
      <p class="font-heading text-3xl md:text-6xl font-bold leading-tight text-heading">
        {h.workshopTitle1}<br /><span class="gold-text">{h.workshopTitle2}</span>
      </p>
      <div class="ruler my-8 max-w-sm" style="-webkit-mask-image:none;mask-image:none"></div>
      <a href={localize(lang, '/about')} class="btn border-primary/60 text-heading hover:bg-primary/15">
        {h.workshopLink}
        <Icon name="tabler:arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </section>

  <VisitInfo />
</Layout>

<script>
  // 숫자가 0부터 올라가며 채워지는 효과 (예: 55년)
  const run = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-count-to]');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const to = Number(el.dataset.countTo);
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1600);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }),
      { threshold: 0.6 }
    );
    // 화면 가까이 오면 0으로 바꿔 두고, 충분히 보이면 올라가기 시작
    const near = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          near.unobserve(entry.target);
          if (entry.intersectionRatio < 0.6) (entry.target as HTMLElement).textContent = '0';
          io.observe(entry.target);
        }),
      { rootMargin: '0px 0px 300px 0px' }
    );
    els.forEach((el) => near.observe(el));
  };
  document.addEventListener('astro:page-load', run);
</script>
