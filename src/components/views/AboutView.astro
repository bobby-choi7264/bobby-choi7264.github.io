---
// 소개 페이지. 한국어(/about)와 다른 언어(/en/about 등) 페이지가 함께 씁니다.
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Seal from '~/components/common/Seal.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const a = t.about;

const metadata = {
  title: a.metaTitle,
  description: a.metaDescription,
};

const mosaic = [
  { file: 'workshop-47', cls: 'col-span-2 row-span-2' },
  { file: 'column-16', cls: '' },
  { file: 'workshop-08', cls: '' },
  { file: 'lathe-27', cls: 'row-span-2' },
  { file: 'column-29', cls: '' },
  { file: 'furniture-07', cls: 'col-span-2 md:col-span-1' },
  { file: 'column-49', cls: 'col-span-2' },
  { file: 'lathe-55', cls: 'col-span-2 md:col-span-1' },
];
---

<Layout metadata={metadata} lang={lang} crumb={t.nav.about}>
  <section class="relative overflow-hidden px-4 pt-20 pb-14 md:pt-32 md:pb-20 text-center">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src="~/assets/images/works/column-14.jpg"
        alt=""
        widths={[768, 1600]}
        sizes="100vw"
        width={1600}
        height={700}
        layout="cover"
        format="webp"
        loading="eager"
        class="h-full w-full object-cover parallax-img sepia-[0.4]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-[#140f0b]"></div>
    </div>
    <div class="relative">
      <p class="text-sm tracking-[0.3em] text-primary mb-3">{a.tag}</p>
      <h1 class="font-heading text-4xl md:text-6xl font-bold text-heading" translate="no" data-split>성창공예</h1>
      {lang !== 'ko' && <p class="mt-2 text-sm tracking-[0.4em] text-primary/80">{t.brand}</p>}
      <div class="ruler mx-auto my-6 max-w-md"></div>
      <p class="text-default/80">{a.lead}</p>
    </div>
  </section>

  <section class="px-4 py-14 md:py-20">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 items-center">
      <div class="relative max-w-md mx-auto w-full">
        <div class="relative overflow-hidden rounded-xl border border-primary/25 aspect-[3/4]">
          <Image
            src="~/assets/images/works/workshop-46.jpg"
            alt={a.shopAlt}
            widths={[480, 800]}
            sizes="(max-width: 1023px) 100vw, 448px"
            width={800}
            height={1066}
            layout="cover"
            format="webp"
            class="photo-tone h-full w-full object-cover"
          />
          <span class="corner-marks" aria-hidden="true"></span>
        </div>
        <Seal class="stamp-in absolute -bottom-5 -right-3 text-2xl intersect intersect-once intersect-half" />
      </div>
      <div class="space-y-6 text-lg leading-relaxed">
        <p class="font-heading font-bold leading-none">
          <span class="gold-text text-6xl md:text-7xl">55</span><span class="text-2xl text-primary ml-1"
            >{t.home.yearsUnit}</span
          >
          <span class="ml-3 align-middle text-sm tracking-[0.3em] text-primary">{a.yearsSide}</span>
        </p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading text-balance">
          {a.title1}<br /><span class="gold-text">{a.title2}</span>
        </h2>
        {a.paragraphs.map((p) => <p class="about-copy text-pretty" set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="px-4 pb-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">{a.galleryTag}</p>
        <h2 class="font-heading text-2xl md:text-4xl font-bold text-heading text-balance" data-split>
          {a.galleryTitle}
        </h2>
        <div class="ruler mx-auto my-6 max-w-md"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[140px] md:auto-rows-[190px] gap-3">
        {
          mosaic.map(({ file, cls }) => (
            <div
              class={`overflow-hidden rounded-lg border border-primary/20 reveal-wipe intersect intersect-once intersect-quarter ${cls}`}
            >
              <Image
                src={`~/assets/images/works/${file}.jpg`}
                alt=""
                widths={[400, 800]}
                sizes="(max-width: 767px) 50vw, 25vw"
                width={800}
                height={600}
                layout="cover"
                format="webp"
                class="h-full w-full object-cover transition duration-700 hover:scale-105 sepia-[0.2] hover:sepia-0"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <VisitInfo />
</Layout>
