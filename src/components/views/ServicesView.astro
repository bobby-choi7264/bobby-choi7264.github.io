---
// 작업 분야 페이지. 한국어(/services)와 다른 언어 페이지가 함께 씁니다.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { SERVICES, shopFor } from '~/data/shop';
import { galleryBy } from '~/data/works';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = t.servicesPage;
const shop = shopFor(lang);

const metadata = {
  title: p.metaTitle,
  description: p.metaDescription,
};

const stepIcons = ['tabler:message-circle', 'tabler:calculator', 'tabler:tools', 'tabler:package'];
const NUMS = ['壹', '貳', '參', '肆'];
---

<Layout metadata={metadata} lang={lang}>
  <section class="px-4 pt-16 pb-10 md:pt-24 text-center wood-grain">
    <p class="text-sm tracking-[0.3em] text-primary mb-3">{p.tag}</p>
    <h1 class="font-heading text-4xl md:text-6xl font-bold text-heading" data-split>{p.title}</h1>
    <div class="ruler mx-auto my-6 max-w-md"></div>
    <p class="text-muted max-w-2xl mx-auto">{p.lead}</p>
    <nav class="mt-10 flex flex-wrap justify-center gap-2" aria-label={p.title}>
      {
        SERVICES.map((service) => (
          <a
            href={`#${service.key}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-primary/40 px-4 text-sm text-heading transition-colors hover:bg-primary hover:text-[#140f0b]"
          >
            <Icon name={service.icon} class="h-4 w-4" aria-hidden="true" />
            {t.services[service.key].title}
          </a>
        ))
      }
    </nav>
  </section>

  {
    SERVICES.map((service, index) => {
      const s = t.services[service.key];
      const photos = galleryBy(service.key, lang).slice(0, 3);
      return (
        <section id={service.key} class="relative px-4 py-14 md:py-20 scroll-mt-20 overflow-hidden">
          <span
            class:list={[
              'hanja-mark top-6 text-[10rem] md:text-[16rem]',
              index % 2 === 1 ? 'left-0 lg:left-auto lg:right-4' : '-right-4',
            ]}
            aria-hidden="true"
          >
            {NUMS[index]}
          </span>
          <div
            class:list={[
              'relative max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 items-center',
              { 'lg:[&>*:first-child]:order-2': index % 2 === 1 },
            ]}
          >
            <div class="intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade">
              <Icon name={service.icon} class="w-10 h-10 text-primary" />
              <h2 class="mt-4 font-heading text-3xl md:text-4xl font-bold text-heading">{s.title}</h2>
              <p class="mt-4 text-lg text-default/90 text-pretty">{s.description}</p>
              <ul class="mt-6 space-y-3">
                {s.points.map((point) => (
                  <li class="flex gap-3">
                    <Icon name="tabler:check" class="w-5 h-5 mt-1 text-primary shrink-0" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="grid grid-cols-3 gap-3">
              {photos.map((photo, i) => (
                <div
                  class:list={[
                    'relative overflow-hidden rounded-lg border border-primary/20 reveal-wipe intersect intersect-once intersect-quarter',
                    { 'col-span-3 aspect-[16/10]': i === 0, 'aspect-square': i > 0, 'col-span-1': i > 0 },
                  ]}
                >
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={i === 0 ? [640, 1000] : [320, 480]}
                    sizes={i === 0 ? '(max-width: 1023px) 100vw, 50vw' : '(max-width: 1023px) 33vw, 16vw'}
                    width={i === 0 ? 1000 : 480}
                    height={i === 0 ? 625 : 480}
                    layout="cover"
                    format="webp"
                    class="photo-tone h-full w-full object-cover"
                  />
                  {i === 0 && <span class="corner-marks" aria-hidden="true" />}
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="px-4 py-20 bg-dark border-t border-primary/15">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm tracking-[0.3em] text-primary mb-3">{p.stepsTag}</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading" data-split>{p.stepsTitle}</h2>
      </div>
      <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          p.steps.map((step, index) => (
            <li
              class="step-card relative rounded-xl border border-primary/20 p-6 intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
              style={`animation-delay:${index * 0.12}s`}
            >
              <span class="text-primary font-heading text-sm tabular-nums">
                {p.step} {index + 1}
              </span>
              <Icon name={stepIcons[index]} class="w-8 h-8 text-primary mt-3" />
              <h3 class="mt-3 font-heading text-xl font-bold text-heading">{step.title}</h3>
              <p class="mt-2 text-muted text-pretty">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a href={localize(lang, '/contact')} class="btn-primary">{p.orderForm}</a>
        <a href={shop.tel.href} class="btn border-primary/60 text-heading hover:bg-primary/15">{shop.tel.label}</a>
      </div>
    </div>
  </section>
</Layout>
