---
// 마우스 효과: 커서는 원래 모양 그대로 두고, 움직일 때 지나간 자리에 아주 작은 톱밥 가루(황동빛 입자)가
// 흩날리다 사라집니다. 마우스가 있는 컴퓨터에서만 켜지고, 움직임 줄이기 설정이면 꺼집니다.
---

<canvas id="cursor-dust" transition:persist aria-hidden="true"></canvas>

<script>
  type Speck = { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number; hue: number };

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const specks: Speck[] = [];
  let running = false;
  let lastX = -1;
  let lastY = -1;
  let ctx: CanvasRenderingContext2D | null = null;
  let dpr = 1;

  const canvas = () => document.getElementById('cursor-dust') as HTMLCanvasElement | null;

  const resize = () => {
    const c = canvas();
    if (!c) return;
    dpr = Math.min(2, window.devicePixelRatio || 1);
    c.width = innerWidth * dpr;
    c.height = innerHeight * dpr;
    ctx = c.getContext('2d');
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  window.addEventListener('resize', resize);

  const frame = () => {
    if (!ctx) resize();
    if (!ctx) return;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    for (let i = specks.length - 1; i >= 0; i--) {
      const s = specks[i];
      s.life++;
      s.vy += 0.035; // 천천히 가라앉음
      s.vx *= 0.97;
      s.x += s.vx;
      s.y += s.vy;
      const t = s.life / s.max;
      if (t >= 1) {
        specks.splice(i, 1);
        continue;
      }
      ctx.globalAlpha = (1 - t) * 0.85;
      ctx.fillStyle = `hsl(${s.hue} 62% ${70 - t * 20}%)`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.size * (1 - t * 0.5), 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    if (specks.length) requestAnimationFrame(frame);
    else running = false;
  };

  document.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || !fine.matches) return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    const dist = Math.hypot(dx, dy);
    lastX = e.clientX;
    lastY = e.clientY;
    if (dist < 4 || dist > 300) return;
    // 빨리 움직일수록 조금 더 많이, 그래도 한 번에 3개까지만
    const count = Math.min(3, 1 + Math.floor(dist / 18));
    for (let i = 0; i < count && specks.length < 90; i++) {
      specks.push({
        x: e.clientX + (Math.random() - 0.5) * 6,
        y: e.clientY + (Math.random() - 0.5) * 6,
        vx: (Math.random() - 0.5) * 0.8 - dx * 0.02,
        vy: (Math.random() - 0.5) * 0.6 - 0.3,
        life: 0,
        max: 32 + Math.random() * 26,
        size: 0.8 + Math.random() * 1.4,
        hue: 30 + Math.random() * 12,
      });
    }
    if (!running) {
      running = true;
      requestAnimationFrame(frame);
    }
  });
  document.addEventListener('astro:page-load', resize);
</script>
