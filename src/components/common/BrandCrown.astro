---
// 상호 위에 얹는 '거목' 표시 (사장님 요청, 명함에도 있는 호). 양옆의 가는 황동 선이 아래 상호 폭에 맞춰 늘어납니다.
// 글자 크기와 색은 class로 정합니다. 회사명 자체는 '성창공예' 그대로입니다.
import { SHOP } from '~/data/shop';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`brand-crown ${className}`} translate="no">
  <span class="brand-crown-line" aria-hidden="true"></span>
  <span class="brand-crown-text">{SHOP.prefix}</span>
  <span class="brand-crown-line" aria-hidden="true"></span>
</span>

<style>
  .brand-crown {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    width: 100%;
    font-family: var(--aw-font-heading, inherit);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .brand-crown-text {
    letter-spacing: 0.2em;
    margin-right: -0.2em;
  }
  .brand-crown-line {
    flex: 1 1 0;
    min-width: 0.6em;
    height: 1px;
    background: currentColor;
    opacity: 0.65;
  }
</style>
