---
// 글 공유 버튼. 휴대폰에서는 '공유하기'를 누르면 카카오톡·문자 등 휴대폰 공유 창이 열리고,
// 공유 창이 없는 컴퓨터에서는 주소를 복사합니다.
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<aw-social-share class={className} data-aw-url={String(url)} data-aw-text={text}>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-aw-share
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-primary/40 px-4 text-sm text-heading hover:bg-primary/15"
    >
      <Icon name="tabler:share" class="h-5 w-5 text-primary" />공유하기
    </button>
    <button
      type="button"
      data-aw-copy
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-primary/40 px-4 text-sm text-heading hover:bg-primary/15"
    >
      <Icon name="tabler:link" class="h-5 w-5 text-primary" /><span data-aw-copy-label>링크 복사</span>
    </button>
  </div>
</aw-social-share>

<script>
  class AwSocialShare extends HTMLElement {
    connectedCallback() {
      const url = this.dataset.awUrl ?? location.href;
      const text = this.dataset.awText ?? document.title;
      const label = this.querySelector<HTMLElement>('[data-aw-copy-label]');

      const copy = async () => {
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = '복사했습니다';
        } catch {
          window.prompt('아래 주소를 복사하세요', url);
          return;
        }
        setTimeout(() => label && (label.textContent = '링크 복사'), 2000);
      };

      this.querySelector('[data-aw-copy]')?.addEventListener('click', copy);
      this.querySelector('[data-aw-share]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: text, url });
          } catch {
            /* 사용자가 공유 창을 닫음 */
          }
        } else {
          copy();
        }
      });
    }
  }

  if (!customElements.get('aw-social-share')) {
    customElements.define('aw-social-share', AwSocialShare);
  }
</script>
