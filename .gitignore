# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro
# local Claude Code settings
.claude/

# 인계 문서 (개인 메모 포함, 공개 저장소에 올리지 않음)
HANDOFF.md
design-preview/

# 네이버 스마트플레이스 등록 준비물 (사진·안내, 공개 저장소에 올리지 않음)
smartplace/
